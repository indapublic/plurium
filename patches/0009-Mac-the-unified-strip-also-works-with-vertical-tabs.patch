+  void CopyVerticalTabsState(const ProfileTabsWindow& from) {
+    auto* source = tabs::VerticalTabStripStateController::From(from.browser());
+    auto* target = tabs::VerticalTabStripStateController::From(browser());
+    if (!source || !target) {
+      return;
+    }
+    if (target->GetUncollapsedWidth() != source->GetUncollapsedWidth()) {
+      target->SetUncollapsedWidth(source->GetUncollapsedWidth());
+    }
+    if (target->IsCollapsed() != source->IsCollapsed()) {
+      target->RequestCollapse(source->IsCollapsed());
+    }
+  }
