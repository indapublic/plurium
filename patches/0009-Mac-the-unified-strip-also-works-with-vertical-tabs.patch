+  // tab strip does not jump when switching between profiles.
+  void OnVerticalTabsCollapseChanged(
+      tabs::VerticalTabStripCollapseState state) {
+    if (state == tabs::VerticalTabStripCollapseState::kCollapsing ||
+        !attached_) {
+      return;
+    }
+    for (ProfileTabsWindow* window : AllWindows()) {
+      if (window != this && window->attached()) {
+        window->CopyVerticalTabsState(*this);
+      }
+    }
