+               list_height + kVerticalTabSpacing),
+      width() - 2 * kVerticalNewTabInset, kVerticalTabHeight);
+  const auto place = [&](UnifiedTabView* tab, int y) {
+    tab->SetBounds(0, y - scroll_offset_, width(), kVerticalTabHeight);
+    tab->SetVisible(tab->y() + tab->height() <= list_height &&
+                    tab->bounds().bottom() > 0);
