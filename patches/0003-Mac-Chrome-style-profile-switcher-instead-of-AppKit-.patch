+bool ContainsNativeTabBar(NSView* view) {
+  if ([NSStringFromClass([view class]) isEqualToString:@"NSTabBar"]) {
+    return true;
+  }
+  for (NSView* subview in view.subviews) {
+    if (ContainsNativeTabBar(subview)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Hides AppKit's tab bar; the profile switcher chip replaces it. AppKit hosts
+// the bar in a titlebar accessory of every window in the group. Returns false
+// if no such accessory exists (yet).
+bool HideNativeTabBar(NSWindow* window) {
+  for (NSTitlebarAccessoryViewController* accessory in window
+           .titlebarAccessoryViewControllers) {
+    if (ContainsNativeTabBar(accessory.view)) {
+      accessory.hidden = YES;
+      return true;
+    }
+  }
+  return false;
+}
