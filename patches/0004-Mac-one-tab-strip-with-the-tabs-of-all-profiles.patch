+// The unified tab strip shows the tabs of all profile windows in one global
+// order. Within one window it always follows Chromium's own tab order, so
+// keyboard shortcuts, session restore and extensions keep working; the global
+// order only decides how the windows' tabs interleave.
+struct TabSlot {
+  raw_ptr<ProfileTabsWindow> window;
+  raw_ptr<tabs::TabInterface> tab;
+};
+
+std::vector<TabSlot>& TabOrder() {
+  static base::NoDestructor<std::vector<TabSlot>> order;
+  return *order;
+}
+
+size_t IndexOfTab(const tabs::TabInterface* tab) {
+  const std::vector<TabSlot>& order = TabOrder();
+  for (size_t i = 0; i < order.size(); ++i) {
+    if (order[i].tab == tab) {
+      return i;
+    }
+  }
+  return order.size();
+}
+
+// Where the next tab added to a window goes ("Move to profile").
+struct PendingPlacement {
+  raw_ptr<ProfileTabsWindow> window;
+  size_t index;
+};
+
+std::optional<PendingPlacement>& PendingTabPlacement() {
+  static base::NoDestructor<std::optional<PendingPlacement>> placement;
+  return *placement;
+}
+
+// Window keys of the order saved during the previous run.
+struct SavedTabOrder {
+  bool loaded = false;
+  std::vector<std::string> keys;
+  base::TimeTicks valid_until;
+};
+
+NSString* TabOrderPrefsKey() {
+  base::FilePath user_data_dir;
+  base::PathService::Get(chrome::DIR_USER_DATA, &user_data_dir);
+  return base::SysUTF8ToNSString("TabOrder " + user_data_dir.value());
+}
+
+SavedTabOrder& GetSavedTabOrder() {
+  static base::NoDestructor<SavedTabOrder> saved;
+  if (!saved->loaded) {
+    saved->loaded = true;
+    for (id key in [ProfileTabsDefaults() arrayForKey:TabOrderPrefsKey()]) {
+      if ([key isKindOfClass:[NSString class]]) {
+        saved->keys.push_back(base::SysNSStringToUTF8(key));
+      }
+    }
+    saved->valid_until = base::TimeTicks::Now() + kRestoreTabOrderPeriod;
+  }
+  return *saved;
+}
