+// Brings the global order in line with the windows' tab strips: drops closed
+// tabs, keeps each window's tabs in Chromium's order and places new tabs.
+void ReconcileTabOrder() {
+  std::vector<ProfileTabsWindow*> windows;
+  std::map<ProfileTabsWindow*, std::vector<tabs::TabInterface*>> window_tabs;
+  for (ProfileTabsWindow* window : AllWindows()) {
+    if (!window->attached()) {
+      continue;
+    }
+    windows.push_back(window);
+    TabStripModel* model = window->model();
+    for (int i = 0; i < model->count(); ++i) {
+      window_tabs[window].push_back(model->GetTabAtIndex(i));
+    }
+  }
+  std::vector<TabSlot>& order = TabOrder();
+
+  // Right after startup, interleave the restored windows' tabs as saved.
+  SavedTabOrder& saved = GetSavedTabOrder();
+  if (base::TimeTicks::Now() >= saved.valid_until) {
+    saved.keys.clear();
+  }
+  if (!saved.keys.empty() && base::TimeTicks::Now() < saved.valid_until) {
+    std::vector<TabSlot> restored;
+    std::map<ProfileTabsWindow*, size_t> next;
+    bool complete = true;
+    for (const std::string& key : saved.keys) {
+      const auto window = std::ranges::find_if(
+          windows, [&](ProfileTabsWindow* w) { return w->persist_key() == key; });
+      if (window == windows.end() ||
+          next[*window] >= window_tabs[*window].size()) {
+        complete = false;
+        continue;
+      }
+      restored.push_back(
+          TabSlot{*window, window_tabs[*window][next[*window]++]});
+    }
+    for (ProfileTabsWindow* window : windows) {
+      for (size_t i = next[window]; i < window_tabs[window].size(); ++i) {
+        restored.push_back(TabSlot{window, window_tabs[window][i]});
+      }
+    }
+    order = std::move(restored);
+    if (complete) {
+      saved.keys.clear();
+    }
+    return;
+  }
+
+  std::erase_if(order, [&](const TabSlot& slot) {
+    const auto it = window_tabs.find(slot.window);
+    return it == window_tabs.end() ||
+           !std::ranges::contains(it->second, slot.tab.get());
+  });
+
+  // Each window's slots, refilled in Chromium's order of its tabs.
+  for (ProfileTabsWindow* window : windows) {
+    std::vector<size_t> positions;
+    for (size_t i = 0; i < order.size(); ++i) {
+      if (order[i].window == window) {
+        positions.push_back(i);
+      }
+    }
+    size_t next = 0;
+    for (tabs::TabInterface* tab : window_tabs[window]) {
+      if (IndexOfTab(tab) < order.size() && next < positions.size()) {
+        order[positions[next++]].tab = tab;
+      }
+    }
+  }
+
+  for (ProfileTabsWindow* window : windows) {
+    const std::vector<tabs::TabInterface*>& tabs = window_tabs[window];
+    for (size_t k = 0; k < tabs.size(); ++k) {
+      if (IndexOfTab(tabs[k]) < order.size()) {
+        continue;
+      }
+      size_t position = order.size();
+      std::optional<PendingPlacement>& pending = PendingTabPlacement();
+      if (pending && pending->window == window) {
+        position = std::min(pending->index, order.size());
+        pending.reset();
+      } else if (k + 1 < tabs.size()) {
+        // Opened between the window's tabs (e.g. from a link): stay next to
+        // them. Tabs appended to the window (Cmd+T) go to the end.
+        position = k > 0 ? IndexOfTab(tabs[k - 1]) + 1 : IndexOfTab(tabs[k + 1]);
+        position = std::min(position, order.size());
+      }
+      order.insert(order.begin() + position, TabSlot{window, tabs[k]});
+    }
+  }
+  ScheduleSaveTabOrder();
+}
+
+void SaveTabOrder() {
+  // Windows close one by one on quit; keep the order they had before that.
+  if (browser_shutdown::HasShutdownStarted() ||
+      !GetSavedTabOrder().keys.empty()) {
+    return;
+  }
+  NSMutableArray<NSString*>* keys = [NSMutableArray array];
+  for (const TabSlot& slot : TabOrder()) {
+    [keys addObject:base::SysUTF8ToNSString(slot.window->persist_key())];
+  }
+  [ProfileTabsDefaults() setObject:keys forKey:TabOrderPrefsKey()];
+}
+
+void ScheduleSaveTabOrder() {
+  static bool posted = false;
+  if (posted) {
+    return;
+  }
+  posted = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce([] {
+        posted = false;
+        SaveTabOrder();
+      }),
+      kSaveTabOrderDelay);
+}
