+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_UNIFIED_TAB_STRIP_MAC_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_UNIFIED_TAB_STRIP_MAC_H_
+
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/base/models/image_model.h"
+#include "ui/views/context_menu_controller.h"
+#include "ui/views/view.h"
+
+namespace views {
+class ImageButton;
+}
+
+namespace profile_tabs {
+
+class UnifiedTabView;
+
+// What the unified tab strip shows for one tab.
+struct UnifiedTabData {
+  std::u16string title;
+  std::u16string tooltip;
+  ui::ImageModel favicon;
+  // The tab's profile color, shown along the tab's top-left corner.
+  SkColor profile_color = SK_ColorTRANSPARENT;
+  // The active tab of the window showing the strip.
+  bool selected = false;
+  bool loading = false;
+  bool audible = false;
+  bool muted = false;
+};
+
+class UnifiedTabStripDelegate {
+ public:
+  // Whether the tab belongs to the window showing the strip. Such tabs are
+  // activated on mouse press, like Chrome tabs; tabs of other profile windows
+  // on release, since activating them switches windows.
+  virtual bool IsTabInThisWindow(int index) const = 0;
+  virtual void ActivateTab(int index) = 0;
+  virtual void CloseTab(int index) = 0;
+  // Moves the tab at `from` so that it ends up at `to`.
+  virtual void MoveTab(int from, int to) = 0;
+  virtual void NewTab() = 0;
+  virtual void ShowTabMenu(int index, const gfx::Point& screen_point) = 0;
+  virtual void ShowNewTabMenu(const gfx::Point& screen_point) = 0;
+
+ protected:
+  virtual ~UnifiedTabStripDelegate() = default;
+};
+
+// Tab strip with the tabs of all profiles in one order, all drawn the same
+// way whichever profile they belong to; each tab's top-left corner shows
+// its profile's color. Click activates, the close button or a middle
+// click closes, dragging reorders, right click opens the delegate's menus.
+class UnifiedTabStrip : public views::View,
+                        public views::ContextMenuController {
+  METADATA_HEADER(UnifiedTabStrip, views::View)
+
+ public:
+  explicit UnifiedTabStrip(UnifiedTabStripDelegate* delegate);
+  UnifiedTabStrip(const UnifiedTabStrip&) = delete;
+  UnifiedTabStrip& operator=(const UnifiedTabStrip&) = delete;
+  ~UnifiedTabStrip() override;
+
+  void SetTabs(const std::vector<UnifiedTabData>& tabs);
+
+  // HTCLIENT over a tab or the new tab button, HTCAPTION over empty strip
+  // space (so it drags the window), HTNOWHERE outside the strip.
+  // `point_in_parent` is in the parent view's coordinates.
+  int NonClientHitTest(const gfx::Point& point_in_parent) const;
+
+  // Called by tab views when the hover state changes (separators follow it).
+  void OnTabHoverChanged();
+  void CloseTabView(const UnifiedTabView* tab);
+
+  // views::View:
+  void Layout(PassKey) override;
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  bool OnMouseDragged(const ui::MouseEvent& event) override;
+  void OnMouseReleased(const ui::MouseEvent& event) override;
+  void OnMouseCaptureLost() override;
+
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override;
+
+ private:
+  int TabWidth() const;
+  int TabIndexAt(const gfx::Point& point) const;
+  void CancelDrag();
+
+  const raw_ptr<UnifiedTabStripDelegate> delegate_;
+  std::vector<raw_ptr<UnifiedTabView>> tabs_;
+  raw_ptr<views::ImageButton> new_tab_button_ = nullptr;
+
+  int pressed_index_ = -1;
+  int pressed_button_ = 0;  // ui::EF_*_MOUSE_BUTTON
+  gfx::Point press_location_;
+  bool dragging_ = false;
+  int drag_offset_ = 0;
+  int drag_x_ = 0;
+  int drop_index_ = -1;
+};
+
+}  // namespace profile_tabs
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_UNIFIED_TAB_STRIP_MAC_H_
