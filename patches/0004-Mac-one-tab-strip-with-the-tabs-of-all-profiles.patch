+// Dragging a tab changes its place in the global order. Its window's own tab
+// order (Chromium's) is updated to match.
+void MoveTabInOrder(int from, int to) {
+  std::vector<TabSlot>& order = TabOrder();
+  const int count = static_cast<int>(order.size());
+  if (from < 0 || from >= count || to < 0 || to >= count || from == to) {
+    return;
+  }
+  // A manual move ends the startup restore of the saved order.
+  GetSavedTabOrder().keys.clear();
+  const TabSlot moved = order[from];
+  order.erase(order.begin() + from);
+  order.insert(order.begin() + to, moved);
+  int position = 0;
+  for (int i = 0; i < to; ++i) {
+    if (order[i].window == moved.window) {
+      ++position;
+    }
+  }
+  TabStripModel* model = moved.window->model();
+  const int current = model->GetIndexOfTab(moved.tab);
+  if (current >= 0 && current != position) {
+    model->MoveWebContentsAt(current, position, /*select_after_move=*/false);
+  }
+  ScheduleSaveTabOrder();
+  PostUpdateAllStrips();
+}
