+#include "ui/views/controls/throbber.h"
+#include "ui/views/widget/widget.h"
+
+namespace profile_tabs {
+namespace {
+
+constexpr int kTabMaxWidth = 240;
+constexpr int kTabMinWidth = 24;
+// Below this width a tab shows just its icon.
+constexpr int kTabNarrowWidth = 56;
+// Below this width even the active tab hides its close button.
+constexpr int kTabCloseMinWidth = 64;
+constexpr int kTabTopInset = 5;
+constexpr int kTabPadding = 10;
+constexpr int kIconSize = 16;
+constexpr int kIconTitleSpacing = 8;
+constexpr int kCloseButtonSize = 20;
+constexpr int kCornerRadius = 8;
+// The profile color mark: a triangle filling the tab's top-left corner.
+constexpr float kProfileMarkSize = 14;
+constexpr int kHoverBottomInset = 4;
+constexpr int kSeparatorHeight = 16;
+constexpr int kNewTabButtonSize = 28;
+constexpr int kNewTabButtonSpacing = 6;
+
+}  // namespace
+
+// One tab. Mouse presses go to the strip (which handles activation and
+// dragging); only the close button handles its own clicks.
+class UnifiedTabView : public views::View {
+  METADATA_HEADER(UnifiedTabView, views::View)
+
+ public:
+  explicit UnifiedTabView(UnifiedTabStrip* strip) : strip_(strip) {
+    SetNotifyEnterExitOnChild(true);
+    GetViewAccessibility().SetRole(ax::mojom::Role::kTab);
+
+    icon_ = AddChildView(std::make_unique<views::ImageView>());
+    icon_->SetCanProcessEventsWithinSubtree(false);
+    throbber_ = AddChildView(std::make_unique<views::Throbber>());
+    throbber_->SetCanProcessEventsWithinSubtree(false);
+    throbber_->SetVisible(false);
+
+    // Same setup as Chrome's tab titles.
+    title_ = AddChildView(std::make_unique<views::Label>());
+    title_->SetHorizontalAlignment(gfx::ALIGN_TO_HEAD);
+    title_->SetElideBehavior(gfx::FADE_TAIL);
+    title_->SetHandlesTooltips(false);
+    title_->SetAutoColorReadabilityEnabled(false);
+    title_->SetBackgroundColor(SK_ColorTRANSPARENT);
+    title_->SetSkipSubpixelRenderingOpacityCheck(true);
+    title_->SetCanProcessEventsWithinSubtree(false);
+
+    audio_ = AddChildView(std::make_unique<views::ImageView>());
+    audio_->SetCanProcessEventsWithinSubtree(false);
+    audio_->SetVisible(false);
+
+    close_ = AddChildView(std::make_unique<views::ImageButton>(
+        base::BindRepeating(&UnifiedTabView::OnClosePressed,
+                            base::Unretained(this))));
+    close_->SetImageHorizontalAlignment(views::ImageButton::ALIGN_CENTER);
+    close_->SetImageVerticalAlignment(views::ImageButton::ALIGN_MIDDLE);
+    close_->SetTooltipText(u"Close tab");
+    close_->GetViewAccessibility().SetName(u"Close tab");
+    close_->SetVisible(false);
+  }
+
+  const UnifiedTabData& data() const { return data_; }
+  bool hovered() const { return hovered_; }
+
+  void SetData(const UnifiedTabData& data) {
+    data_ = data;
+    icon_->SetImage(data_.favicon);
+    title_->SetText(data_.title);
+    SetTooltipText(data_.tooltip);
+    GetViewAccessibility().SetName(data_.title);
+    if (data_.loading) {
+      throbber_->Start();
+    } else {
+      throbber_->Stop();
+    }
+    if (data_.audible || data_.muted) {
+      audio_->SetImage(ui::ImageModel::FromVectorIcon(
+          data_.muted ? vector_icons::kVolumeOffIcon
+                      : vector_icons::kVolumeUpIcon,
+          ForegroundColorId(), kIconSize));
+    }
+    UpdateColors();
+    DeprecatedLayoutImmediately();
+    SchedulePaint();
+  }
+
+  void SetShowSeparator(bool show) {
+    if (show != show_separator_) {
+      show_separator_ = show;
+      SchedulePaint();
+    }
+  }
+
+  // views::View:
+  void Layout(PassKey) override {
+    const int center_y = kTabTopInset + (height() - kTabTopInset) / 2;
+    const bool narrow = width() < kTabNarrowWidth;
+    int left = kTabPadding;
+    int right = width() - kTabPadding;
+
+    const bool show_close =
+        (data_.selected || hovered_) && width() >= kTabCloseMinWidth;
+    close_->SetVisible(show_close);
+    if (show_close) {
+      close_->SetBounds(right - kCloseButtonSize,
+                        center_y - kCloseButtonSize / 2, kCloseButtonSize,
+                        kCloseButtonSize);
+      right -= kCloseButtonSize + 4;
+    }
+    const bool show_audio = (data_.audible || data_.muted) && !narrow;
+    audio_->SetVisible(show_audio);
+    if (show_audio) {
+      audio_->SetBounds(right - kIconSize, center_y - kIconSize / 2, kIconSize,
+                        kIconSize);
+      right -= kIconSize + 4;
+    }
+
+    const int icon_x = narrow ? (width() - kIconSize) / 2 : left;
+    const gfx::Rect icon_bounds(icon_x, center_y - kIconSize / 2, kIconSize,
+                                kIconSize);
+    icon_->SetBoundsRect(icon_bounds);
+    throbber_->SetBoundsRect(icon_bounds);
+    icon_->SetVisible(!data_.loading);
+    throbber_->SetVisible(data_.loading);
+
+    title_->SetVisible(!narrow);
+    if (!narrow) {
+      const int title_x = left + kIconSize + kIconTitleSpacing;
+      title_->SetBounds(title_x, kTabTopInset, std::max(right - title_x, 0),
+                        height() - kTabTopInset);
+    }
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    // Frame-active colors whether or not the window is active, so a tab never
+    // changes its look when focus moves.
+    const ui::ColorProvider* colors = GetColorProvider();
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+
+    if (data_.selected) {
+      // Merges into the toolbar below, like Chrome's active tab.
+      flags.setColor(colors->GetColor(kColorTabBackgroundActiveFrameActive));
+      const gfx::RectF rect(0, kTabTopInset, width(), height() - kTabTopInset);
+      canvas->DrawRoundRect(rect, kCornerRadius, flags);
+      canvas->DrawRect(gfx::RectF(0, rect.CenterPoint().y(), width(),
+                                  rect.height() / 2),
+                       flags);
+    } else if (hovered_) {
+      flags.setColor(
+          colors->GetColor(kColorTabBackgroundInactiveHoverFrameActive));
+      canvas->DrawRoundRect(
+          gfx::RectF(2, kTabTopInset, width() - 4,
+                     height() - kTabTopInset - kHoverBottomInset + 1),
+          kCornerRadius, flags);
+    }
+
+    if (SkColorGetA(data_.profile_color)) {
+      // Clipped to the rounded corner of the active tab's background.
+      gfx::ScopedCanvas scoped_canvas(canvas);
+      canvas->ClipPath(
+          SkPath::RRect(SkRRect::MakeRectXY(
+              SkRect::MakeLTRB(0, kTabTopInset, width(),
+                               height() + kCornerRadius),
+              kCornerRadius, kCornerRadius)),
+          /*do_anti_alias=*/true);
+      SkPathBuilder triangle;
+      triangle.moveTo(0, kTabTopInset);
+      triangle.lineTo(kProfileMarkSize, kTabTopInset);
+      triangle.lineTo(0, kTabTopInset + kProfileMarkSize);
+      triangle.close();
+      cc::PaintFlags mark;
+      mark.setAntiAlias(true);
+      mark.setColor(data_.profile_color);
+      canvas->DrawPath(triangle.detach(), mark);
+    }
+
+    if (show_separator_) {
+      canvas->FillRect(
+          gfx::Rect(width() - 1,
+                    kTabTopInset +
+                        (height() - kTabTopInset - kSeparatorHeight) / 2,
+                    1, kSeparatorHeight),
+          colors->GetColor(kColorTabDividerFrameActive));
+    }
+  }
+
+  void OnThemeChanged() override {
+    views::View::OnThemeChanged();
+    UpdateColors();
+  }
+
+  void OnMouseEntered(const ui::MouseEvent& event) override {
+    SetHovered(true);
+  }
+  void OnMouseExited(const ui::MouseEvent& event) override {
+    SetHovered(false);
+  }
+
+ private:
+  ui::ColorId ForegroundColorId() const {
+    return data_.selected ? kColorTabForegroundActiveFrameActive
+                          : kColorTabForegroundInactiveFrameActive;
+  }
+
+  void UpdateColors() {
+    if (!GetColorProvider()) {
+      return;
+    }
+    title_->SetEnabledColor(GetColorProvider()->GetColor(ForegroundColorId()));
+    close_->SetImageModel(
+        views::Button::STATE_NORMAL,
+        ui::ImageModel::FromVectorIcon(features::IsRoundedIconsEnabled()
+                                           ? kCloseWeight500CustomIcon
+                                           : kCloseTabChromeRefreshOldIcon,
+                                       ForegroundColorId(), kIconSize));
+  }
+
+  void SetHovered(bool hovered) {
+    if (hovered == hovered_) {
+      return;
+    }
+    hovered_ = hovered;
+    DeprecatedLayoutImmediately();
+    SchedulePaint();
+    strip_->OnTabHoverChanged();
+  }
+
+  void OnClosePressed() { strip_->CloseTabView(this); }
+
+  const raw_ptr<UnifiedTabStrip> strip_;
+  UnifiedTabData data_;
+  bool hovered_ = false;
+  bool show_separator_ = false;
+  raw_ptr<views::ImageView> icon_ = nullptr;
+  raw_ptr<views::Throbber> throbber_ = nullptr;
+  raw_ptr<views::Label> title_ = nullptr;
+  raw_ptr<views::ImageView> audio_ = nullptr;
+  raw_ptr<views::ImageButton> close_ = nullptr;
+};
+
+BEGIN_METADATA(UnifiedTabView)
+END_METADATA
+
+UnifiedTabStrip::UnifiedTabStrip(UnifiedTabStripDelegate* delegate)
+    : delegate_(delegate) {
+  new_tab_button_ = AddChildView(std::make_unique<views::ImageButton>(
+      base::BindRepeating(
+          [](UnifiedTabStrip* strip) { strip->delegate_->NewTab(); },
+          base::Unretained(this))));
+  new_tab_button_->SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(
+          features::IsRoundedIconsEnabled()
+              ? vector_icons::kAddWeight500CustomIcon
+              : vector_icons::kAddOldIcon,
+          kColorTabForegroundInactiveFrameActive, kIconSize));
+  new_tab_button_->SetImageHorizontalAlignment(
+      views::ImageButton::ALIGN_CENTER);
+  new_tab_button_->SetImageVerticalAlignment(views::ImageButton::ALIGN_MIDDLE);
+  new_tab_button_->SetTooltipText(u"New tab (right click: choose profile)");
+  new_tab_button_->GetViewAccessibility().SetName(u"New tab");
+  new_tab_button_->set_context_menu_controller(this);
+  set_context_menu_controller(this);
+}
+
+UnifiedTabStrip::~UnifiedTabStrip() = default;
+
+void UnifiedTabStrip::SetTabs(const std::vector<UnifiedTabData>& tabs) {
+  if (dragging_ && tabs.size() != tabs_.size()) {
+    CancelDrag();
+  }
+  while (tabs_.size() < tabs.size()) {
+    auto* tab = AddChildView(std::make_unique<UnifiedTabView>(this));
+    tab->set_context_menu_controller(this);
+    tabs_.push_back(tab);
+  }
+  while (tabs_.size() > tabs.size()) {
+    UnifiedTabView* tab = tabs_.back();
+    tabs_.pop_back();
+    RemoveChildViewT(tab);
+  }
+  for (size_t i = 0; i < tabs.size(); ++i) {
+    tabs_[i]->SetData(tabs[i]);
+  }
+  // The frame view does not lay out children that only invalidated their
+  // layout, so lay out right away.
+  DeprecatedLayoutImmediately();
+  SchedulePaint();
+}
+
+int UnifiedTabStrip::NonClientHitTest(const gfx::Point& point_in_parent) const {
+  if (!GetVisible()) {
+    return HTNOWHERE;
+  }
+  const gfx::Point point = point_in_parent - bounds().OffsetFromOrigin();
+  if (!GetLocalBounds().Contains(point)) {
+    return HTNOWHERE;
+  }
+  if (TabIndexAt(point) >= 0 || new_tab_button_->bounds().Contains(point)) {
+    return HTCLIENT;
+  }
+  return HTCAPTION;
+}
+
+void UnifiedTabStrip::OnTabHoverChanged() {
+  DeprecatedLayoutImmediately();
+}
+
+void UnifiedTabStrip::CloseTabView(const UnifiedTabView* tab) {
+  const auto it = std::ranges::find(tabs_, tab);
+  if (it != tabs_.end()) {
+    delegate_->CloseTab(static_cast<int>(it - tabs_.begin()));
+  }
+}
+
+int UnifiedTabStrip::TabWidth() const {
+  const int count = static_cast<int>(tabs_.size());
+  if (!count) {
+    return kTabMaxWidth;
+  }
+  const int available =
+      width() - kNewTabButtonSize - 2 * kNewTabButtonSpacing;
+  return std::clamp(available / count, kTabMinWidth, kTabMaxWidth);
+}
+
+int UnifiedTabStrip::TabIndexAt(const gfx::Point& point) const {
+  for (size_t i = 0; i < tabs_.size(); ++i) {
+    if (tabs_[i]->bounds().Contains(point)) {
+      return static_cast<int>(i);
+    }
+  }
+  return -1;
+}
+
+void UnifiedTabStrip::Layout(PassKey) {
+  const int tab_width = TabWidth();
+  const int count = static_cast<int>(tabs_.size());
+  int slot = 0;
+  for (int i = 0; i < count; ++i) {
+    if (dragging_ && i == pressed_index_) {
+      continue;
+    }
+    if (dragging_ && slot == drop_index_) {
+      ++slot;
+    }
+    tabs_[i]->SetBounds(slot * tab_width, 0, tab_width, height());
+    ++slot;
+  }
+  if (dragging_) {
+    tabs_[pressed_index_]->SetBounds(drag_x_, 0, tab_width, height());
+  }
+  // Separators between tabs, but not next to the active or a hovered tab,
+  // nor right before a profile color corner, which marks the tab already.
+  for (int i = 0; i < count; ++i) {
+    const bool last = i == count - 1;
+    const auto quiet = [&](int index) {
+      return !tabs_[index]->data().selected && !tabs_[index]->hovered();
+    };
+    tabs_[i]->SetShowSeparator(
+        !dragging_ && !last && quiet(i) && quiet(i + 1) &&
+        !SkColorGetA(tabs_[i + 1]->data().profile_color));
+  }
+  new_tab_button_->SetBounds(
+      count * tab_width + kNewTabButtonSpacing,
+      kTabTopInset + (height() - kTabTopInset - kNewTabButtonSize) / 2,
+      kNewTabButtonSize, kNewTabButtonSize);
+}
+
+bool UnifiedTabStrip::OnMousePressed(const ui::MouseEvent& event) {
+  const int index = TabIndexAt(event.location());
+  if (index < 0 || event.IsRightMouseButton()) {
+    return false;
+  }
+  pressed_index_ = index;
+  pressed_button_ = event.changed_button_flags();
+  press_location_ = event.location();
+  if (event.IsOnlyLeftMouseButton() && delegate_->IsTabInThisWindow(index)) {
+    delegate_->ActivateTab(index);
+  }
+  return true;
+}
+
+bool UnifiedTabStrip::OnMouseDragged(const ui::MouseEvent& event) {
+  if (pressed_index_ < 0 || pressed_button_ != ui::EF_LEFT_MOUSE_BUTTON) {
+    return false;
+  }
+  const int tab_width = TabWidth();
+  if (!dragging_) {
+    if (!ExceededDragThreshold(event.location() - press_location_)) {
+      return true;
+    }
+    dragging_ = true;
+    drag_offset_ = press_location_.x() - tabs_[pressed_index_]->x();
+    ReorderChildView(tabs_[pressed_index_], children().size());
+  }
+  const int count = static_cast<int>(tabs_.size());
+  drag_x_ = std::clamp(event.location().x() - drag_offset_, 0,
+                       (count - 1) * tab_width);
+  drop_index_ = std::clamp((drag_x_ + tab_width / 2) / tab_width, 0, count - 1);
+  DeprecatedLayoutImmediately();
+  return true;
+}
+
+void UnifiedTabStrip::OnMouseReleased(const ui::MouseEvent& event) {
+  const int index = pressed_index_;
+  const int button = pressed_button_;
+  pressed_index_ = -1;
+  if (dragging_) {
+    const int to = drop_index_;
+    dragging_ = false;
+    drop_index_ = -1;
+    DeprecatedLayoutImmediately();
+    if (to != index) {
+      delegate_->MoveTab(index, to);
+    }
+    return;
+  }
+  if (index < 0 || TabIndexAt(event.location()) != index) {
+    return;
+  }
+  if (button == ui::EF_MIDDLE_MOUSE_BUTTON) {
+    delegate_->CloseTab(index);
+  } else if (button == ui::EF_LEFT_MOUSE_BUTTON &&
+             !delegate_->IsTabInThisWindow(index)) {
+    delegate_->ActivateTab(index);
+  }
+}
+
+void UnifiedTabStrip::OnMouseCaptureLost() {
+  CancelDrag();
+}
+
+void UnifiedTabStrip::CancelDrag() {
+  pressed_index_ = -1;
+  dragging_ = false;
+  drop_index_ = -1;
+  DeprecatedLayoutImmediately();
+}
+
+void UnifiedTabStrip::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  gfx::Point local = point;
+  ConvertPointFromScreen(this, &local);
+  if (source == new_tab_button_.get() ||
+      new_tab_button_->bounds().Contains(local)) {
+    delegate_->ShowNewTabMenu(point);
+    return;
+  }
+  const int index = TabIndexAt(local);
+  if (index >= 0) {
+    delegate_->ShowTabMenu(index, point);
+  }
+}
