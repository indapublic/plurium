From e8106653db91af2d20728ac79ddae816adc0ce26 Mon Sep 17 00:00:00 2001
From: Vasilii Zolotukhin <vasilii.zolotukhin@gmail.com>
Date: Mon, 5 Oct 2026 16:56:00 +1000
Subject: [PATCH 5/6] Mac: Plurium branding for the profile-tabs build

The build otherwise looks like a regular Chromium to macOS: same bundle
id (Dock, Launch Services, default browser, permissions), same name
and, without --user-data-dir, the same ~/Library/Application
Support/Chromium.

- MAC_BUNDLE_ID is com.indapublic.plurium (helpers follow it) and
  MAC_TEAM_ID is 4WSCP7LMZQ, the Developer ID team it is signed with.
- CFBundleName and CFBundleDisplayName of the app are "Plurium" (menu
  bar, Dock, Finder).
- CrProductDirName "Plurium" moves the default user data and cache
  directories to ~/Library/Application Support/Plurium and
  ~/Library/Caches/Plurium.
- IDS_PRODUCT_NAME, IDS_SHORT_PRODUCT_NAME and IDS_APP_MENU_PRODUCT_NAME
  (not translated) are "Plurium": About/Hide/Quit menu items, window
  titles, permission prompts.
- Assets.car and app.icns hold a violet recolor of the Chromium icon,
  compiled from the unchanged upstream sources with
  tools/mac/icons/compile_car.py (see patches/tools/make-icon.py).

With the GN arg plurium_dev_build = true (for test builds) the app is
"Plurium Dev": bundle id <MAC_BUNDLE_ID>.dev, data directory "Plurium
Dev" and an orange icon (Assets_dev.car, app_dev.icns), so tests never
share settings, permissions or the Dock with the installed release. The
name comes from the new PLURIUM_APP_NAME plist substitution and the icon
files are copied under their usual names.

The app bundle, executable, framework and helpers keep their Chromium
names, which the code relies on; install it as "Plurium.app".
---
 build/util/branding.gni                      |  14 ++++++++++++++
 chrome/BUILD.gn                              |  18 ++++++++++++++----
 chrome/app/app-Info.plist                    |   6 ++++--
 chrome/app/chromium_strings.grd              |   6 +++---
 chrome/app/theme/chromium/BRANDING           |   4 ++--
 chrome/app/theme/chromium/mac/Assets.car     | Bin 437192 -> 1487608 bytes
 chrome/app/theme/chromium/mac/Assets_dev.car | Bin 0 -> 1477032 bytes
 chrome/app/theme/chromium/mac/app.icns       | Bin 85977 -> 53991 bytes
 chrome/app/theme/chromium/mac/app_dev.icns   | Bin 0 -> 54220 bytes
 9 files changed, 37 insertions(+), 11 deletions(-)
 create mode 100644 chrome/app/theme/chromium/mac/Assets_dev.car
 create mode 100644 chrome/app/theme/chromium/mac/app_dev.icns

diff --git a/build/util/branding.gni b/build/util/branding.gni
index 1d4ffd68a75da..b996529dded54 100644
--- a/build/util/branding.gni
+++ b/build/util/branding.gni
@@ -43,3 +43,17 @@ if (is_mac) {
   chrome_mac_creator_code = _result.creator_code
   chrome_mac_team_id = _result.team_id
 }
+
+declare_args() {
+  # Plurium: test builds get an app identity of their own ("Plurium Dev": a
+  # .dev bundle id, data directory and icon), apart from the release.
+  plurium_dev_build = false
+}
+
+plurium_app_name = "Plurium"
+if (plurium_dev_build) {
+  plurium_app_name = "Plurium Dev"
+  if (is_mac) {
+    chrome_mac_bundle_id += ".dev"
+  }
+}
diff --git a/chrome/BUILD.gn b/chrome/BUILD.gn
index ce7ebbe4f6b68..6870b8fd2a554 100644
--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -538,6 +538,7 @@ if (is_win) {
       "CHROMIUM_BUNDLE_ID=$chrome_mac_bundle_id",
       "CHROMIUM_SHORT_NAME=$chrome_product_short_name",
       "CHROMIUM_CREATOR=$chrome_mac_creator_code",
+      "PLURIUM_APP_NAME=$plurium_app_name",
     ]
 
     sources = [
@@ -660,14 +661,23 @@ if (is_win) {
     }
   }
 
+  # Plurium Dev has its own icon.
+  _plurium_icon_tag = ""
+  if (plurium_dev_build) {
+    _plurium_icon_tag = "_dev"
+  }
+
   bundle_data("chrome_app_icon") {
-    sources = [ "app/theme/$branding_path_component/mac/app.icns" ]
-    outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
+    sources =
+        [ "app/theme/$branding_path_component/mac/app$_plurium_icon_tag.icns" ]
+    outputs = [ "{{bundle_resources_dir}}/app.icns" ]
   }
 
   bundle_data("chrome_asset_catalog") {
-    sources = [ "app/theme/$branding_path_component/mac/Assets.car" ]
-    outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
+    sources = [
+      "app/theme/$branding_path_component/mac/Assets$_plurium_icon_tag.car",
+    ]
+    outputs = [ "{{bundle_resources_dir}}/Assets.car" ]
   }
 
   bundle_data("chrome_resources") {
diff --git a/chrome/app/app-Info.plist b/chrome/app/app-Info.plist
index 6fada0a2b1a1f..c568d396e3670 100644
--- a/chrome/app/app-Info.plist
+++ b/chrome/app/app-Info.plist
@@ -5,7 +5,7 @@
 	<key>CFBundleDevelopmentRegion</key>
 	<string>en</string>
 	<key>CFBundleDisplayName</key>
-	<string>${EXECUTABLE_NAME}</string>
+	<string>${PLURIUM_APP_NAME}</string>
 	<key>CFBundleDocumentTypes</key>
 	<array>
 		<dict>
@@ -156,11 +156,13 @@
 	<key>CFBundleInfoDictionaryVersion</key>
 	<string>6.0</string>
 	<key>CFBundleName</key>
-	<string>${CHROMIUM_SHORT_NAME}</string>
+	<string>${PLURIUM_APP_NAME}</string>
 	<key>CFBundlePackageType</key>
 	<string>APPL</string>
 	<key>CFBundleSignature</key>
 	<string>${CHROMIUM_CREATOR}</string>
+	<key>CrProductDirName</key>
+	<string>${PLURIUM_APP_NAME}</string>
 	<key>NSAppleScriptEnabled</key>
 	<true/>
 	<key>OSAScriptingDefinition</key>
diff --git a/chrome/app/chromium_strings.grd b/chrome/app/chromium_strings.grd
index d5f9a09fc06cb..0137bba708345 100644
--- a/chrome/app/chromium_strings.grd
+++ b/chrome/app/chromium_strings.grd
@@ -294,10 +294,10 @@ If you update this file, be sure also to update google_chrome_strings.grd. -->
         </then>
         <else>
           <message name="IDS_PRODUCT_NAME" desc="The Chrome application name" translateable="false">
-            Chromium
+            Plurium
           </message>
           <message name="IDS_SHORT_PRODUCT_NAME" desc="The Chrome application short name." translateable="false">
-            Chromium
+            Plurium
           </message>
         </else>
       </if>
@@ -1183,7 +1183,7 @@ Chromium is unable to recover your settings.
 
       <if expr="is_macosx">
         <message name="IDS_APP_MENU_PRODUCT_NAME" desc="The application's short name, used for the Mac's application menu, activity monitor, etc. This should be less than 16 characters. Example: Chrome, not Google Chrome." translateable="false">
-          Chromium
+          Plurium
         </message>
         <message name="IDS_HELPER_NAME" desc="The helper application's name.  Should contain the Chrome application name (IDS_PRODUCT_NAME). Example: Google Chrome Helper.">
           Chromium Helper
diff --git a/chrome/app/theme/chromium/BRANDING b/chrome/app/theme/chromium/BRANDING
index f8363d5b294fe..5ffbbd2648aee 100644
--- a/chrome/app/theme/chromium/BRANDING
+++ b/chrome/app/theme/chromium/BRANDING
@@ -5,6 +5,6 @@ PRODUCT_SHORTNAME=Chromium
 PRODUCT_INSTALLER_FULLNAME=Chromium Installer
 PRODUCT_INSTALLER_SHORTNAME=Chromium Installer
 COPYRIGHT=Copyright @LASTCHANGE_YEAR@ The Chromium Authors. All rights reserved.
-MAC_BUNDLE_ID=org.chromium.Chromium
+MAC_BUNDLE_ID=com.indapublic.plurium
 MAC_CREATOR_CODE=Cr24
-MAC_TEAM_ID=
+MAC_TEAM_ID=4WSCP7LMZQ
