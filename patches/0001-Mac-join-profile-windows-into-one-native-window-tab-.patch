+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_PROFILE_TABS_MAC_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_PROFILE_TABS_MAC_H_
+
+class BrowserView;
+struct BrowserLayoutParams;
+
+namespace gfx {
+class Rect;
+}
+
+namespace views {
+class Widget;
+}
+
+namespace profile_tabs {
+
+// Joins the normal browser windows of all profiles into one native macOS
+// window tab group: one system tab per browser window, titled with the
+// profile name. Call once per browser widget after it is initialized; a
+// normal browser window joins the group the first time it becomes visible.
+// Other window types (DevTools, popups, apps) are left alone.
+void ObserveBrowserWidget(views::Widget* widget, BrowserView* browser_view);
+
+// Layout while a window shows the native tab bar: the standard AppKit
+// titlebar and the tab bar sit above the whole browser UI.
+
+// True if the titlebar should keep its default AppKit height instead of
+// Chromium's tab strip height.
+bool UseSystemTitlebar(const views::Widget* widget);
+
+// Moves the top of `bounds` (the client view bounds) below the tab bar.
+gfx::Rect AdjustClientBounds(const views::Widget* widget,
+                             const gfx::Rect& bounds);
+
+// Drops the caption button exclusion: the traffic lights are no longer next
+// to the tab strip.
+void AdjustLayoutParams(const views::Widget* widget,
+                        BrowserLayoutParams& params);
+
+}  // namespace profile_tabs
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_PROFILE_TABS_MAC_H_
