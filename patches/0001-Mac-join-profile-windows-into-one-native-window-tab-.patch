+#include "ui/views/window/non_client_view.h"
+
+namespace profile_tabs {
+namespace {
+
+// Shared by every window in the profile tab group.
+NSString* const kTabbingIdentifier = @"org.chromium.profile-tabs";
+
+class ProfileTabsWindow;
+
+std::vector<ProfileTabsWindow*>& AllWindows() {
+  static base::NoDestructor<std::vector<ProfileTabsWindow*>> windows;
+  return *windows;
+}
+
+std::u16string ProfileDisplayName(Profile* profile) {
+  if (profile->IsGuestSession()) {
+    return u"Guest";
+  }
+  Profile* original = profile->GetOriginalProfile();
+  std::u16string name;
+  if (ProfileManager* manager = g_browser_process->profile_manager()) {
+    if (ProfileAttributesEntry* entry =
+            manager->GetProfileAttributesStorage()
+                .GetProfileAttributesWithPath(original->GetPath())) {
+      name = entry->GetName();
+    }
+  }
+  if (name.empty()) {
+    name = original->GetPath().BaseName().LossyDisplayName();
+  }
+  if (profile->IsOffTheRecord()) {
+    name += u" (Incognito)";
+  }
+  return name;
+}
+
+// Frontmost visible window that already belongs to the profile tab group.
+NSWindow* FindGroupWindow(NSWindow* exclude) {
+  for (NSWindow* window in NSApp.orderedWindows) {
+    if (window != exclude && window.visible && !window.miniaturized &&
+        [window.tabbingIdentifier isEqualToString:kTabbingIdentifier]) {
+      return window;
+    }
+  }
+  return nil;
+}
+
+void UpdateAllTitles();
+void RefreshAllLayouts();
+void EnsureWindowNotifications();
+
+// Keeps system tab titles in sync with profile names.
+class TitleUpdater : public ProfileAttributesStorage::Observer,
+                     public ProfileManagerObserver {
+ public:
+  explicit TitleUpdater(ProfileManager* manager) {
+    storage_observation_.Observe(&manager->GetProfileAttributesStorage());
+    manager_observation_.Observe(manager);
+  }
+
+  // ProfileAttributesStorage::Observer:
+  void OnProfileNameChanged(const base::FilePath& profile_path,
+                            const std::u16string& old_profile_name) override {
+    UpdateAllTitles();
+  }
+
+  // ProfileManagerObserver:
+  void OnProfileManagerDestroying() override {
+    storage_observation_.Reset();
+    manager_observation_.Reset();
+  }
+
+ private:
+  base::ScopedObservation<ProfileAttributesStorage,
+                          ProfileAttributesStorage::Observer>
+      storage_observation_{this};
+  base::ScopedObservation<ProfileManager, ProfileManagerObserver>
+      manager_observation_{this};
+};
+
+void EnsureTitleUpdater() {
+  if (ProfileManager* manager = g_browser_process->profile_manager()) {
+    static base::NoDestructor<TitleUpdater> updater(manager);
+  }
+}
+
+// Watches one normal browser widget. The first time it becomes visible the
+// window joins the profile tab group; later visibility changes (AppKit
+// switching tabs) are ignored. Owns itself and dies with the widget.
+class ProfileTabsWindow : public views::WidgetObserver {
+ public:
+  ProfileTabsWindow(views::Widget* widget, BrowserView* browser_view)
+      : widget_(widget), browser_view_(browser_view) {
+    observation_.Observe(widget);
+    AllWindows().push_back(this);
+  }
+  ProfileTabsWindow(const ProfileTabsWindow&) = delete;
+  ProfileTabsWindow& operator=(const ProfileTabsWindow&) = delete;
+  ~ProfileTabsWindow() override { std::erase(AllWindows(), this); }
+
+  views::Widget* widget() const { return widget_; }
+  Profile* profile() const { return browser_view_->browser()->GetProfile(); }
+  bool attached() const { return attached_; }
+  int ordinal() const { return ordinal_; }
+  bool system_titlebar() const { return system_titlebar_; }
+  NSWindow* ns_window() const { return GetNSWindow(); }
+
+  // Height of the AppKit titlebar plus the native tab bar above the browser
+  // UI, or 0 when the window uses Chromium's own titlebar layout. Cached so
+  // it only changes right before a relayout: BrowserView's layout CHECKs
+  // that its bounds stay inside the client area.
+  int TopInset() const { return system_titlebar_ ? top_inset_ : 0; }
+
+  // AppKit fullscreen transitions: Chromium defers its own layout until they
+  // finish, so don't switch layouts in the middle of one.
+  void SetFullscreenTransition(bool in_transition, bool entering) {
+    fullscreen_transition_ = in_transition;
+    if (in_transition && entering) {
+      // Fullscreen uses Chromium's own (immersive) layout.
+      ApplyLayout(false, /*refresh_titlebar=*/false);
+    }
+  }
+
+  // Switches between Chromium's titlebar layout and the "profile tabs on top"
+  // layout whenever the native tab bar appears or disappears.
+  void RefreshLayout() {
+    NSWindow* window = GetNSWindow();
+    if (!window || widget_->IsClosed() || fullscreen_transition_) {
+      return;
+    }
+    const bool fullscreen = window.styleMask & NSWindowStyleMaskFullScreen;
+    const bool wanted =
+        attached_ && !fullscreen && window.tabGroup.windows.count > 1;
+    ApplyLayout(wanted, /*refresh_titlebar=*/!fullscreen);
+  }
+
+  void UpdateTitle() {
+    NSWindow* window = GetNSWindow();
+    if (!window) {
+      return;
+    }
+    std::u16string title = ProfileDisplayName(profile());
+    if (ordinal_ > 1) {
+      title += u" " + base::NumberToString16(ordinal_);
+    }
+    window.tab.title = base::SysUTF16ToNSString(title);
+  }
+
+  // views::WidgetObserver:
+  void OnWidgetVisibilityChanged(views::Widget* widget, bool visible) override {
+    if (!visible || attach_posted_ || handled_) {
+      return;
+    }
+    attach_posted_ = true;
+    // Regroup after AppKit has finished ordering the window in.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&ProfileTabsWindow::Attach,
+                                  weak_factory_.GetWeakPtr()));
+  }
+
+  void OnWidgetDestroying(views::Widget* widget) override { delete this; }
+
+ private:
+  NSWindow* GetNSWindow() const {
+    auto* host = views::NativeWidgetMacNSWindowHost::GetFromNativeWindow(
+        widget_->GetNativeWindow());
+    return host ? host->GetInProcessNSWindow() : nil;
+  }
+
+  // 1 for the first window of a profile, 2 for the second one, and so on.
+  int NextOrdinal() const {
+    int ordinal = 1;
+    for (ProfileTabsWindow* other : AllWindows()) {
+      if (other->attached() && other->profile() == profile()) {
+        ordinal = std::max(ordinal, other->ordinal() + 1);
+      }
+    }
+    return ordinal;
+  }
+
+  void ApplyLayout(bool system_titlebar, bool refresh_titlebar) {
+    NSWindow* window = GetNSWindow();
+    if (!window || system_titlebar == system_titlebar_) {
+      return;
+    }
+    // TopInset() still returns the old value here, so any layout AppKit
+    // triggers below sees consistent bounds.
+    system_titlebar_ = system_titlebar;
+    if (refresh_titlebar) {
+      // Make AppKit query the titlebar height again; same trick as
+      // BrowserFrameViewMac::OnTabStripStateChanged().
+      const NSRect frame = window.frame;
+      const NSUInteger style_mask = window.styleMask;
+      window.styleMask = style_mask ^ NSWindowStyleMaskFullSizeContentView;
+      window.styleMask = style_mask;
+      [window setFrame:frame display:NO];
+    }
+    top_inset_ = system_titlebar_
+                     ? std::max(0.0, NSHeight(window.frame) -
+                                         NSMaxY(window.contentLayoutRect))
+                     : 0;
+    // The frame view positions the client view (BrowserView).
+    widget_->non_client_view()->frame_view()->InvalidateLayout();
+    widget_->LayoutRootViewIfNecessary();
+    VLOG(1) << "profile tabs: " << base::SysNSStringToUTF8(window.tab.title)
+            << (system_titlebar_ ? " tab bar layout, top inset "
+                                 : " default layout ")
+            << top_inset_;
+  }
+
+  void Attach() {
+    attach_posted_ = false;
+    NSWindow* window = GetNSWindow();
+    if (!window || widget_->IsClosed() || !widget_->IsVisible()) {
+      return;
+    }
+    if (TabDragController::IsActive()) {
+      // The window was torn off a tab strip and is following the mouse.
+      // Leave it as a separate window.
+      handled_ = true;
+      VLOG(1) << "profile tabs: skip window created by a tab drag";
+      return;
+    }
+
+    handled_ = true;
+    attached_ = true;
+    ordinal_ = NextOrdinal();
+    window.tabbingIdentifier = kTabbingIdentifier;
+    window.tabbingMode = NSWindowTabbingModePreferred;
+    UpdateTitle();
+    EnsureTitleUpdater();
+
+    EnsureWindowNotifications();
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&RefreshAllLayouts));
+
+    NSWindow* group_window = FindGroupWindow(window);
+    if (!group_window) {
+      VLOG(1) << "profile tabs: first window "
+              << base::SysNSStringToUTF8(window.tab.title);
+      return;
+    }
+    // Append to the end of the group so tab positions stay stable. Keep the
+    // current selection unless this window was activated (e.g. session
+    // restore and focused:false windows must not steal focus).
+    const bool was_active = widget_->IsActive();
+    NSWindowTabGroup* group = group_window.tabGroup;
+    NSWindow* selected = group.selectedWindow;
+    NSWindow* last = group.windows.lastObject ?: group_window;
+    [last addTabbedWindow:window ordered:NSWindowAbove];
+    if (was_active) {
+      [window makeKeyAndOrderFront:nil];
+    } else if (selected) {
+      group.selectedWindow = selected;
+    }
+    VLOG(1) << "profile tabs: attached "
+            << base::SysNSStringToUTF8(window.tab.title) << ", group size "
+            << window.tabGroup.windows.count;
+  }
+
+  raw_ptr<views::Widget> widget_;
+  raw_ptr<BrowserView> browser_view_;
+  bool attach_posted_ = false;
+  // Set once the window was either attached or deliberately left alone.
+  bool handled_ = false;
+  bool attached_ = false;
+  bool system_titlebar_ = false;
+  bool fullscreen_transition_ = false;
+  int top_inset_ = 0;
+  int ordinal_ = 0;
+  base::ScopedObservation<views::Widget, views::WidgetObserver> observation_{
+      this};
+  base::WeakPtrFactory<ProfileTabsWindow> weak_factory_{this};
+};
+
+void UpdateAllTitles() {
+  for (ProfileTabsWindow* window : AllWindows()) {
+    if (window->attached()) {
+      window->UpdateTitle();
+    }
+  }
+}
+
+void RefreshAllLayouts() {
+  // RefreshLayout() can run nested layout code; iterate over a copy.
+  const std::vector<ProfileTabsWindow*> windows = AllWindows();
+  for (ProfileTabsWindow* window : windows) {
+    if (std::ranges::contains(AllWindows(), window)) {
+      window->RefreshLayout();
+    }
+  }
+}
+
+ProfileTabsWindow* FindWindowForNSWindow(id ns_window) {
+  for (ProfileTabsWindow* window : AllWindows()) {
+    if (window->ns_window() == ns_window) {
+      return window;
+    }
+  }
+  return nullptr;
+}
+
+void PostRefreshAllLayouts() {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&RefreshAllLayouts));
+}
+
+void ObserveNotification(NSNotificationName name,
+                         void (^handler)(NSNotification*)) {
+  [NSNotificationCenter.defaultCenter addObserverForName:name
+                                                  object:nil
+                                                   queue:nil
+                                              usingBlock:handler];
+}
+
+// The tab bar appears or disappears when windows join, leave (closing, or a
+// system tab dragged out) or change fullscreen state.
+void EnsureWindowNotifications() {
+  static bool installed = false;
+  if (installed) {
+    return;
+  }
+  installed = true;
+  for (NSNotificationName name in @[
+         NSWindowDidBecomeKeyNotification, NSWindowWillCloseNotification
+       ]) {
+    ObserveNotification(name, ^(NSNotification*) {
+      PostRefreshAllLayouts();
+    });
+  }
+  ObserveNotification(NSWindowWillEnterFullScreenNotification,
+                      ^(NSNotification* notification) {
+                        if (auto* window =
+                                FindWindowForNSWindow(notification.object)) {
+                          window->SetFullscreenTransition(true, true);
+                        }
+                      });
+  ObserveNotification(NSWindowWillExitFullScreenNotification,
+                      ^(NSNotification* notification) {
+                        if (auto* window =
+                                FindWindowForNSWindow(notification.object)) {
+                          window->SetFullscreenTransition(true, false);
+                        }
+                      });
+  for (NSNotificationName name in @[
+         NSWindowDidEnterFullScreenNotification,
+         NSWindowDidExitFullScreenNotification
+       ]) {
+    ObserveNotification(name, ^(NSNotification* notification) {
+      if (auto* window = FindWindowForNSWindow(notification.object)) {
+        window->SetFullscreenTransition(false, false);
+      }
+      PostRefreshAllLayouts();
+    });
+  }
+}
+
+ProfileTabsWindow* FindWindow(const views::Widget* widget) {
+  for (ProfileTabsWindow* window : AllWindows()) {
+    if (window->widget() == widget) {
+      return window;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+void ObserveBrowserWidget(views::Widget* widget, BrowserView* browser_view) {
+  BrowserWindowInterface* browser = browser_view->browser();
+  if (!browser || browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return;
+  }
+  if (FindWindow(widget)) {
+    return;
+  }
+  new ProfileTabsWindow(widget, browser_view);  // Owns itself.
+}
+
+bool UseSystemTitlebar(const views::Widget* widget) {
+  ProfileTabsWindow* window = FindWindow(widget);
+  return window && window->system_titlebar();
+}
+
+gfx::Rect AdjustClientBounds(const views::Widget* widget,
+                             const gfx::Rect& bounds) {
+  ProfileTabsWindow* window = FindWindow(widget);
+  gfx::Rect adjusted = bounds;
+  if (window) {
+    adjusted.Inset(gfx::Insets::TLBR(
+        std::min(window->TopInset(), bounds.height()), 0, 0, 0));
+  }
+  return adjusted;
+}
+
+void AdjustLayoutParams(const views::Widget* widget,
+                        BrowserLayoutParams& params) {
+  if (!UseSystemTitlebar(widget)) {
+    return;
+  }
+  params.leading_exclusion.content.set_width(0);
+  params.leading_exclusion.horizontal_padding = 0;
+  params.trailing_exclusion.content.set_width(0);
+  params.trailing_exclusion.horizontal_padding = 0;
+}
+
+}  // namespace profile_tabs
