+
+// Updates of Plurium through Homebrew. A short while after startup and then
+// every few hours the version in the published cask is compared with the
+// installed one. A newer version is offered in the app menu and the tab strip;
+// updating quits Plurium, runs `brew upgrade --cask` and reopens it with the
+// same tabs. Builds not installed with Homebrew only point to the release
+// page.
+namespace plurium_update {
+
+// Starts the checks; later calls only replace `on_change`, which runs on the
+// UI thread whenever the available version changes.
+void Start(base::RepeatingClosure on_change);
+
+// The newer version, e.g. u"154.0.8037.99-1", or empty.
+std::u16string AvailableVersion();
+
+// Asks whether to update now and updates if confirmed.
+void PromptForUpdate();
+
+}  // namespace plurium_update
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_PLURIUM_UPDATE_MAC_H_
