+namespace plurium_update {
+namespace {
+
+// The cask is the source of truth: it is what `brew upgrade` installs.
+constexpr char kCaskUrl[] =
+    "https://raw.githubusercontent.com/indapublic/plurium/main/Casks/"
+    "plurium.rb";
+constexpr char kReleasesUrl[] =
+    "https://github.com/indapublic/plurium/releases/latest";
+constexpr char kCask[] = "indapublic/plurium/plurium";
+constexpr char kCaskToken[] = "plurium";
+// Overrides kCaskUrl, for testing.
+constexpr char kFeedSwitch[] = "plurium-update-feed";
+// Set to NO with `defaults write com.indapublic.plurium <key> -bool NO` to
+// turn off the automatic checks ("Check for Updates…" keeps working).
+NSString* const kAutomaticChecksKey = @"PluriumAutomaticUpdateChecks";
+
+constexpr base::TimeDelta kFirstCheckDelay = base::Minutes(1);
+constexpr base::TimeDelta kCheckInterval = base::Hours(6);
+
+// Runs detached: waits for Plurium to quit, upgrades it and reopens it.
+// Arguments: pid, brew, cask, app bundle, log file, then the relaunch
+// switches. `brew update` first: `brew upgrade` refreshes taps only daily.
+constexpr char kUpdateScript[] = R"sh(pid=$1 brew=$2 cask=$3 app=$4 log=$5
+shift 5
+mkdir -p "$(dirname "$log")"
+while kill -0 "$pid" 2>/dev/null; do sleep 0.5; done
+{
+  echo "=== $(date)"
+  export HOMEBREW_NO_ENV_HINTS=1
+  "$brew" update --quiet
+  "$brew" upgrade --cask "$cask"
+  echo "brew upgrade exit code: $?"
+} >> "$log" 2>&1
+open -a "$app" --args "$@"
+)sh";
+
+using Version = std::vector<int>;
+
+// "154.0.8037.98-1" (or with a leading "v") -> {154, 0, 8037, 98, 1}.
+Version ParseVersion(std::string_view text) {
+  if (text.starts_with('v')) {
+    text.remove_prefix(1);
+  }
+  Version version;
+  for (std::string_view part : base::SplitStringPiece(
+           text, ".-", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    int number = 0;
+    if (!base::StringToInt(part, &number)) {
+      return {};
+    }
+    version.push_back(number);
+  }
+  return version;
+}
+
+std::string VersionString(const Version& version) {
+  std::string text;
+  for (size_t i = 0; i < version.size(); ++i) {
+    if (i) {
+      text += i == 4 ? "-" : ".";
+    }
+    text += base::NumberToString(version[i]);
+  }
+  return text;
+}
+
+// The `version "..."` line of a cask.
+Version CaskVersion(std::string_view cask) {
+  constexpr std::string_view kKey = "version \"";
+  const size_t start = cask.find(kKey);
+  if (start == std::string_view::npos) {
+    return {};
+  }
+  const size_t begin = start + kKey.size();
+  const size_t end = cask.find('"', begin);
+  return end == std::string_view::npos
+             ? Version()
+             : ParseVersion(cask.substr(begin, end - begin));
+}
+
+// The Homebrew installation the running app belongs to.
+struct BrewInstall {
+  base::FilePath brew;
+  Version version;
+};
+
+// Blocking: looks at the Caskroom and where the app runs from.
+std::optional<BrewInstall> FindBrewInstall(base::FilePath bundle) {
+  const base::FilePath home = base::GetHomeDir();
+  if (bundle != base::FilePath("/Applications/Plurium.app") &&
+      bundle != home.Append("Applications/Plurium.app")) {
+    return std::nullopt;
+  }
+  for (const char* prefix : {"/opt/homebrew", "/usr/local"}) {
+    const base::FilePath brew = base::FilePath(prefix).Append("bin/brew");
+    const base::FilePath caskroom =
+        base::FilePath(prefix).Append("Caskroom").Append(kCaskToken);
+    if (!base::PathExists(brew) || !base::DirectoryExists(caskroom)) {
+      continue;
+    }
+    BrewInstall install{brew, {}};
+    base::FileEnumerator versions(caskroom, /*recursive=*/false,
+                                  base::FileEnumerator::DIRECTORIES);
+    for (base::FilePath dir = versions.Next(); !dir.empty();
+         dir = versions.Next()) {
+      install.version =
+          std::max(install.version, ParseVersion(dir.BaseName().value()));
+    }
+    if (!install.version.empty()) {
+      return install;
+    }
+  }
+  return std::nullopt;
+}
+
+Version RunningVersion() {
+  NSString* version = [base::apple::OuterBundle()
+      objectForInfoDictionaryKey:@"CFBundleShortVersionString"];
+  return ParseVersion(base::SysNSStringToUTF8(version ?: @""));
+}
+
+NSWindow* AlertWindow() {
+  NSWindow* window = NSApp.keyWindow ?: NSApp.mainWindow;
+  while (window.parentWindow) {
+    window = window.parentWindow;
+  }
+  return window;
+}
+
+void ShowAlert(NSAlert* alert, void (^handler)(NSModalResponse)) {
+  if (NSWindow* window = AlertWindow()) {
+    [alert beginSheetModalForWindow:window completionHandler:handler];
+  } else {
+    handler([alert runModal]);
+  }
+}
+
+}  // namespace
+}  // namespace plurium_update
+
+// Target of the app menu item.
+@interface PluriumUpdateMenuTarget : NSObject
+- (void)checkForUpdates:(id)sender;
+@end
+
+namespace plurium_update {
+namespace {
+
+class Updater {
+ public:
+  Updater() = default;
+
+  void Start(base::RepeatingClosure on_change) {
+    on_change_ = std::move(on_change);
+    if (started_) {
+      return;
+    }
+    started_ = true;
+    UpdateMenuItem();
+    if (AutomaticChecksEnabled()) {
+      const bool testing =
+          base::CommandLine::ForCurrentProcess()->HasSwitch(kFeedSwitch);
+      first_check_.Start(FROM_HERE,
+                         testing ? base::Seconds(3) : kFirstCheckDelay,
+                         base::BindOnce(&Updater::Check, base::Unretained(this),
+                                        /*user_initiated=*/false));
+      periodic_checks_.Start(
+          FROM_HERE, kCheckInterval,
+          base::BindRepeating(&Updater::Check, base::Unretained(this),
+                              /*user_initiated=*/false));
+    }
+  }
+
+  const Version& available() const { return available_; }
+
+  void Check(bool user_initiated) {
+    if (checking_) {
+      return;
+    }
+    checking_ = true;
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock()},
+        base::BindOnce(&FindBrewInstall, base::apple::OuterBundlePath()),
+        base::BindOnce(&Updater::OnInstallFound, base::Unretained(this),
+                       user_initiated));
+  }
+
+  void PromptForUpdate() {
+    if (available_.empty()) {
+      Check(/*user_initiated=*/true);
+      return;
+    }
+    const std::string version = VersionString(available_);
+    NSAlert* alert = [[NSAlert alloc] init];
+    alert.messageText = base::SysUTF8ToNSString(
+        "Plurium " + version + " is available");
+    if (install_) {
+      alert.informativeText =
+          @"Plurium will quit, update with Homebrew and reopen with all your "
+          @"tabs. It takes about a minute.";
+      [alert addButtonWithTitle:@"Update and Relaunch"];
+    } else {
+      alert.informativeText =
+          @"This copy of Plurium was not installed with Homebrew. Download the "
+          @"new version from the release page, or install it with: brew "
+          @"install --cask indapublic/plurium/plurium";
+      [alert addButtonWithTitle:@"Open Release Page"];
+    }
+    [alert addButtonWithTitle:@"Later"];
+    ShowAlert(alert, ^(NSModalResponse response) {
+      if (response != NSAlertFirstButtonReturn) {
+        return;
+      }
+      if (install_) {
+        ApplyUpdate();
+      } else {
+        [NSWorkspace.sharedWorkspace
+            openURL:[NSURL URLWithString:@(kReleasesUrl)]];
+      }
+    });
+  }
+
+  void OnCheckMenuItem() {
+    if (available_.empty()) {
+      Check(/*user_initiated=*/true);
+    } else {
+      PromptForUpdate();
+    }
+  }
+
+ private:
+  static bool AutomaticChecksEnabled() {
+    NSUserDefaults* defaults = NSUserDefaults.standardUserDefaults;
+    return [defaults objectForKey:kAutomaticChecksKey] == nil ||
+           [defaults boolForKey:kAutomaticChecksKey];
+  }
+
+  void OnInstallFound(bool user_initiated,
+                      std::optional<BrewInstall> install) {
+    install_ = std::move(install);
+    const base::CommandLine& command_line =
+        *base::CommandLine::ForCurrentProcess();
+    std::string url = command_line.GetSwitchValueASCII(kFeedSwitch);
+    if (url.empty()) {
+      url = kCaskUrl;
+    }
+    NSURLSession* session = [NSURLSession
+        sessionWithConfiguration:NSURLSessionConfiguration
+                                     .ephemeralSessionConfiguration];
+    scoped_refptr<base::SequencedTaskRunner> ui_task_runner =
+        base::SequencedTaskRunner::GetCurrentDefault();
+    NSURLSessionDataTask* task = [session
+          dataTaskWithURL:[NSURL URLWithString:base::SysUTF8ToNSString(url)]
+        completionHandler:^(NSData* data, NSURLResponse* response,
+                            NSError* error) {
+          const NSInteger status =
+              [response isKindOfClass:[NSHTTPURLResponse class]]
+                  ? static_cast<NSHTTPURLResponse*>(response).statusCode
+                  : 0;
+          std::string body;
+          if (!error && status == 200 && data) {
+            const base::span<const uint8_t> bytes =
+                base::apple::NSDataToSpan(data);
+            body.assign(bytes.begin(), bytes.end());
+          }
+          ui_task_runner->PostTask(
+              FROM_HERE,
+              base::BindOnce(&Updater::OnCaskFetched, base::Unretained(this),
+                             user_initiated, std::move(body)));
+        }];
+    [task resume];
+    [session finishTasksAndInvalidate];
+  }
+
+  void OnCaskFetched(bool user_initiated, std::string cask) {
+    checking_ = false;
+    const Version latest = CaskVersion(cask);
+    // The installed version knows its release number; the app only knows
+    // the Chromium version.
+    const Version current = install_ ? install_->version : RunningVersion();
+    VLOG(1) << "plurium update: latest " << VersionString(latest)
+            << ", installed " << VersionString(current)
+            << (install_ ? " (Homebrew)" : " (not Homebrew)");
+    if (latest.empty()) {
+      if (user_initiated) {
+        NSAlert* alert = [[NSAlert alloc] init];
+        alert.messageText = @"Could not check for updates";
+        alert.informativeText = @"Check the connection and try again.";
+        ShowAlert(alert, ^(NSModalResponse) {
+        });
+      }
+      return;
+    }
+    const Version available = latest > current ? latest : Version();
+    if (available != available_) {
+      available_ = available;
+      UpdateMenuItem();
+      if (on_change_) {
+        on_change_.Run();
+      }
+    }
+    if (!user_initiated) {
+      return;
+    }
+    if (available_.empty()) {
+      NSAlert* alert = [[NSAlert alloc] init];
+      alert.messageText = @"Plurium is up to date";
+      alert.informativeText = base::SysUTF8ToNSString(
+          "Version " + VersionString(current) + " is the latest.");
+      ShowAlert(alert, ^(NSModalResponse) {
+      });
+    } else {
+      PromptForUpdate();
+    }
+  }
+
+  // Quits, and the detached script updates and reopens Plurium, restoring
+  // every profile's windows like chrome::AttemptRestart() does.
+  void ApplyUpdate() {
+    if (!install_) {
+      return;
+    }
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [](BrowserWindowInterface* browser) {
+          browser->GetProfile()->SaveSessionState();
+          return true;
+        });
+    g_browser_process->local_state()->SetBoolean(prefs::kWasRestarted, true);
+
+    const base::FilePath log = base::GetHomeDir().Append(
+        "Library/Logs/Plurium/update.log");
+    std::vector<std::string> argv = {
+        "/bin/sh",
+        "-c",
+        kUpdateScript,
+        "plurium-update",
+        base::NumberToString(base::GetCurrentProcId()),
+        install_->brew.value(),
+        kCask,
+        base::apple::OuterBundlePath().value(),
+        log.value()};
+    for (const auto& [name, value] :
+         base::CommandLine::ForCurrentProcess()->GetSwitches()) {
+      if (name.starts_with("psn") || name == switches::kRestoreLastSession) {
+        continue;
+      }
+      argv.push_back("--" + name + (value.empty() ? "" : "=" + value));
+    }
+    argv.push_back(std::string("--") + switches::kRestoreLastSession);
+
+    base::LaunchOptions options;
+    options.new_process_group = true;
+    options.disclaim_responsibility = true;
+    if (!base::LaunchProcess(argv, options).IsValid()) {
+      LOG(ERROR) << "plurium update: could not start the update script";
+      return;
+    }
+    VLOG(1) << "plurium update: quitting to update to "
+            << VersionString(available_);
+    chrome::AttemptExit();
+  }
+
+  // "Check for Updates…" after "About Plurium" in the app menu, or the
+  // update when there is one.
+  void UpdateMenuItem() {
+    NSMenu* app_menu = NSApp.mainMenu.itemArray.firstObject.submenu;
+    if (!app_menu) {
+      return;
+    }
+    if (!menu_target_) {
+      menu_target_ = [[PluriumUpdateMenuTarget alloc] init];
+    }
+    NSMenuItem* item = nil;
+    for (NSMenuItem* candidate in app_menu.itemArray) {
+      if (candidate.target == menu_target_) {
+        item = candidate;
+      }
+    }
+    if (!item) {
+      item = [[NSMenuItem alloc] initWithTitle:@""
+                                        action:@selector(checkForUpdates:)
+                                 keyEquivalent:@""];
+      item.target = menu_target_;
+      const NSInteger about = [app_menu indexOfItemWithTag:IDC_ABOUT];
+      [app_menu insertItem:item atIndex:about >= 0 ? about + 1 : 0];
+    }
+    item.title =
+        available_.empty()
+            ? @"Check for Updates…"
+            : base::SysUTF8ToNSString("Update to " +
+                                      VersionString(available_) + "…");
+  }
+
+  bool started_ = false;
+  bool checking_ = false;
+  base::RepeatingClosure on_change_;
+  base::OneShotTimer first_check_;
+  base::RepeatingTimer periodic_checks_;
+  std::optional<BrewInstall> install_;
+  Version available_;
+  PluriumUpdateMenuTarget* __strong menu_target_ = nil;
+};
+
+Updater& GetUpdater() {
+  static base::NoDestructor<Updater> updater;
+  return *updater;
+}
+
+}  // namespace
+
+void Start(base::RepeatingClosure on_change) {
+  GetUpdater().Start(std::move(on_change));
+}
+
+std::u16string AvailableVersion() {
+  const Version& available = GetUpdater().available();
+  return available.empty() ? std::u16string()
+                           : base::UTF8ToUTF16(VersionString(available));
+}
+
+void PromptForUpdate() {
+  GetUpdater().PromptForUpdate();
+}
+
+}  // namespace plurium_update
+
+@implementation PluriumUpdateMenuTarget
+- (void)checkForUpdates:(id)sender {
+  plurium_update::GetUpdater().OnCheckMenuItem();
+}
+@end
