+// The first letter of the profile's name, for ProfileMarkStyle::kInitial.
+std::u16string ProfileInitial(Profile* profile) {
+  NSString* name = base::SysUTF16ToNSString(
+      ProfileDisplayName(profile->GetOriginalProfile()));
