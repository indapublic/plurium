+// A dot over the favicon's bottom-right corner: ProfileMarkStyle::kIconBadge,
+// and kDot and kInitial on icon-only tabs. A child of its tab so it is drawn
+// over the favicon.
+class IconBadgeView : public views::View {
+  METADATA_HEADER(IconBadgeView, views::View)
+
+ public:
+  IconBadgeView() { SetCanProcessEventsWithinSubtree(false); }
+
+  // The ring, in the tab's background color, sets the dot off the favicon.
+  void SetColors(SkColor color, SkColor ring) {
+    if (color != color_ || ring != ring_) {
+      color_ = color;
+      ring_ = ring;
+      SchedulePaint();
+    }
+  }
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    const gfx::PointF center = gfx::RectF(GetLocalBounds()).CenterPoint();
+    const float radius = width() / 2.0f;
+    flags.setColor(ring_);
+    canvas->DrawCircle(center, radius, flags);
+    flags.setColor(color_);
+    canvas->DrawCircle(center, radius - kMarkBadgeRing, flags);
+  }
+
+ private:
+  SkColor color_ = SK_ColorTRANSPARENT;
+  SkColor ring_ = SK_ColorTRANSPARENT;
+};
+
+BEGIN_METADATA(IconBadgeView)
+END_METADATA
