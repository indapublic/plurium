+// Ctrl+1 ... Ctrl+9 select the N-th system tab of the profile tab group, like
+// Cmd+1 ... Cmd+9 do for tabs in the tab strip. Chrome itself does not use
+// Ctrl+digit on Mac. Key codes keep this independent of the keyboard layout.
+bool HandleTabHotkey(NSEvent* event) {
+  const NSEventModifierFlags modifiers =
+      event.modifierFlags & NSEventModifierFlagDeviceIndependentFlagsMask &
+      ~(NSEventModifierFlagCapsLock | NSEventModifierFlagNumericPad |
+        NSEventModifierFlagFunction);
+  if (modifiers != NSEventModifierFlagControl) {
+    return false;
+  }
+  // {digit row, keypad} key codes for 1 ... 9.
+  static constexpr std::array<std::pair<unsigned short, unsigned short>, 9>
+      kKeys = {{{kVK_ANSI_1, kVK_ANSI_Keypad1},
+                {kVK_ANSI_2, kVK_ANSI_Keypad2},
+                {kVK_ANSI_3, kVK_ANSI_Keypad3},
+                {kVK_ANSI_4, kVK_ANSI_Keypad4},
+                {kVK_ANSI_5, kVK_ANSI_Keypad5},
+                {kVK_ANSI_6, kVK_ANSI_Keypad6},
+                {kVK_ANSI_7, kVK_ANSI_Keypad7},
+                {kVK_ANSI_8, kVK_ANSI_Keypad8},
+                {kVK_ANSI_9, kVK_ANSI_Keypad9}}};
+  NSUInteger index = 0;
+  for (const auto& [digit, keypad] : kKeys) {
+    if (event.keyCode == digit || event.keyCode == keypad) {
+      break;
+    }
+    ++index;
+  }
+  if (index == kKeys.size()) {
+    return false;
+  }
+  // Bubbles and the omnibox popup are child windows of the browser window.
+  NSWindow* window = NSApp.mainWindow ?: NSApp.keyWindow;
+  while (window.parentWindow) {
+    window = window.parentWindow;
+  }
+  if (![window.tabbingIdentifier isEqualToString:kTabbingIdentifier]) {
+    return false;
+  }
+  NSArray<NSWindow*>* tabs = window.tabGroup.windows;
+  if (index >= tabs.count) {
+    return false;
+  }
+  window.tabGroup.selectedWindow = tabs[index];
+  [tabs[index] makeKeyAndOrderFront:nil];
+  return true;
+}
+
+void EnsureTabHotkeys() {
+  static id monitor = nil;
+  if (monitor) {
+    return;
+  }
+  monitor = [NSEvent
+      addLocalMonitorForEventsMatchingMask:NSEventMaskKeyDown
+                                   handler:^NSEvent*(NSEvent* event) {
+                                     return HandleTabHotkey(event) ? nil
+                                                                   : event;
+                                   }];
+}
