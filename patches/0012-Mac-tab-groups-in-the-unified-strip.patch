+// Dragging a group header moves the group's tabs, so that its first tab ends
+// up at `to` in the global order.
+void MoveGroupInOrder(ProfileTabsWindow* window,
+                      const tab_groups::TabGroupId& group,
+                      int to) {
+  std::vector<TabSlot>& order = TabOrder();
+  const auto in_group = [&](const TabSlot& slot) {
+    return slot.window == window && slot.tab->GetGroup() == group;
+  };
+  const auto first = std::ranges::find_if(order, in_group);
+  const int start = static_cast<int>(first - order.begin());
+  const int size = static_cast<int>(std::ranges::count_if(order, in_group));
+  const int pinned = static_cast<int>(std::ranges::count_if(
+      order, [](const TabSlot& slot) { return slot.tab->IsPinned(); }));
+  if (!size || to < pinned || to + size > static_cast<int>(order.size()) ||
+      to == start) {
+    return;
+  }
+  GetSavedTabOrder().keys.clear();
+  const std::vector<TabSlot> block(first, first + size);
+  order.erase(first, first + size);
+  order.insert(order.begin() + to, block.begin(), block.end());
+  int position = 0;
+  for (int i = 0; i < to; ++i) {
+    if (order[i].window == window) {
+      ++position;
+    }
+  }
+  // The group goes between groups of its window, never into one.
+  TabStripModel* model = window->model();
+  const gfx::Range tabs = model->group_model()->GetTabGroup(group)->ListTabs();
+  std::vector<std::optional<tab_groups::TabGroupId>> others;
+  for (int i = 0; i < model->count(); ++i) {
+    if (!tabs.Contains(gfx::Range(i, i + 1))) {
+      others.push_back(model->GetTabGroupForTab(i));
+    }
+  }
+  const bool splits_group =
+      position > 0 && static_cast<size_t>(position) < others.size() &&
+      others[position - 1] && others[position - 1] == others[position];
+  if (static_cast<int>(tabs.start()) != position && !splits_group) {
+    model->MoveGroupTo(group, position);
   }
   ScheduleSaveTabOrder();
   PostUpdateAllStrips();
 }
 
+// Ctrl+Shift+PgDn / Ctrl+Shift+PgUp, like Chromium's in a window: a tab at
+// the edge of its group leaves the group first, a tab next to a group of its
+// window joins it, and moves past collapsed groups and those of other
+// windows.
+void MoveTabByKey(int index, int direction) {
+  const std::vector<TabSlot>& order = TabOrder();
+  const TabSlot slot = order[index];
+  const std::optional<tab_groups::TabGroupId> group = slot.tab->GetGroup();
+  const int next = index + direction;
+  if (next < 0 || next >= static_cast<int>(order.size())) {
+    if (group) {
+      MoveTabInOrder(index, index, std::nullopt);
+    }
+    return;
+  }
+  const TabSlot neighbor = order[next];
+  const std::optional<tab_groups::TabGroupId> neighbor_group =
+      neighbor.tab->GetGroup();
+  if (group) {
+    MoveTabInOrder(index, neighbor_group == group ? next : index,
+                   neighbor_group == group ? group : std::nullopt);
+    return;
+  }
+  if (!neighbor_group || slot.tab->IsPinned()) {
+    MoveTabInOrder(index, next, std::nullopt);
+    return;
+  }
+  if (neighbor.window == slot.window &&
+      !neighbor.window->model()->IsGroupCollapsed(*neighbor_group)) {
+    MoveTabInOrder(index, index, neighbor_group);
+    return;
+  }
+  int past = next;
+  while (past + direction >= 0 &&
+         past + direction < static_cast<int>(order.size()) &&
+         order[past + direction].tab->GetGroup() == neighbor_group) {
+    past += direction;
+  }
+  MoveTabInOrder(index, past, std::nullopt);
+}
+
+// Whether the strip hides the tab, in a collapsed group.
+bool IsCollapsedTab(const TabSlot& slot) {
+  const std::optional<tab_groups::TabGroupId> group = slot.tab->GetGroup();
+  return group && slot.window->model()->IsGroupCollapsed(*group);
+}
