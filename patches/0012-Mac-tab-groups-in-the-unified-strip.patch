+std::vector<UnifiedTabStrip::Item> UnifiedTabStrip::BuildItems() const {
+  std::vector<Item> items;
+  int previous_group = -1;
+  for (size_t i = 0; i < tabs_.size(); ++i) {
+    int group = tabs_[i]->data().group;
+    if (group < 0 || static_cast<size_t>(group) >= groups_.size()) {
+      group = -1;
+    }
+    if (group >= 0 && group != previous_group) {
+      items.push_back({.header = true, .index = group});
+    }
+    previous_group = group;
+    if (group < 0 || !groups_[group].collapsed) {
+      items.push_back({.header = false, .index = static_cast<int>(i)});
+    }
+  }
+  return items;
+}
+
+views::View* UnifiedTabStrip::ItemView(const Item& item) const {
+  return item.header ? static_cast<views::View*>(headers_[item.index])
+                     : tabs_[item.index];
+}
+
+bool UnifiedTabStrip::IsPinnedItem(const Item& item) const {
+  return !item.header && item.index < pinned_count_;
+}
+
+int UnifiedTabStrip::FirstTabOf(const Item& item) const {
+  if (!item.header) {
+    return item.index;
+  }
+  for (size_t i = 0; i < tabs_.size(); ++i) {
+    if (tabs_[i]->data().group == item.index) {
+      return static_cast<int>(i);
+    }
+  }
+  return static_cast<int>(tabs_.size());
+}
