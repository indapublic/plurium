+bool IsValidGroupMove(TabStripModel* model,
+                      int index,
+                      int to,
+                      std::optional<tab_groups::TabGroupId> group) {
+  std::vector<std::optional<tab_groups::TabGroupId>> others;
+  for (int i = 0; i < model->count(); ++i) {
+    if (i != index) {
+      others.push_back(model->GetTabGroupForTab(i));
+    }
+  }
+  if (to < 0 || static_cast<size_t>(to) > others.size()) {
+    return false;
+  }
+  const std::optional<tab_groups::TabGroupId> left =
+      to > 0 ? others[to - 1] : std::nullopt;
+  const std::optional<tab_groups::TabGroupId> right =
+      static_cast<size_t>(to) < others.size() ? others[to] : std::nullopt;
+  if (left && left == right && left != group) {
+    return false;
+  }
+  return !group || left == group || right == group ||
+         !std::ranges::contains(others, group);
