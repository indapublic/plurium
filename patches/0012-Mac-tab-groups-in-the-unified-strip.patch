+// The header of a tab group: a chip in the group's color with its title (a
+// dot without a title or in collapsed vertical tabs). Clicks and drags go to
+// the strip, like on tabs.
+class UnifiedGroupHeaderView : public views::View {
+  METADATA_HEADER(UnifiedGroupHeaderView, views::View)
+
+ public:
+  explicit UnifiedGroupHeaderView(UnifiedTabStrip* strip) : strip_(strip) {
+    GetViewAccessibility().SetRole(ax::mojom::Role::kButton);
+    title_ = AddChildView(std::make_unique<views::Label>());
+    title_->SetFontList(
+        title_->font_list().DeriveWithWeight(gfx::Font::Weight::MEDIUM));
+    title_->SetElideBehavior(gfx::ELIDE_TAIL);
+    title_->SetHandlesTooltips(false);
+    title_->SetAutoColorReadabilityEnabled(false);
+    title_->SetBackgroundColor(SK_ColorTRANSPARENT);
+    title_->SetSkipSubpixelRenderingOpacityCheck(true);
+    title_->SetCanProcessEventsWithinSubtree(false);
+  }
+
+  const UnifiedGroupData& data() const { return data_; }
+
+  void SetData(const UnifiedGroupData& data) {
+    data_ = data;
+    title_->SetText(data_.title);
+    SetTooltipText(data_.tooltip);
+    GetViewAccessibility().SetName(data_.tooltip);
+    if (data_.collapsed) {
+      GetViewAccessibility().SetIsCollapsed();
+    } else {
+      GetViewAccessibility().SetIsExpanded();
+    }
+    UpdateColors();
+    InvalidateLayout();
+    SchedulePaint();
+  }
+
+  // The width of the header in horizontal tabs.
+  int HorizontalWidth() const {
+    const int chip = data_.title.empty()
+                         ? kGroupEmptyChipWidth
+                         : std::min(title_->GetPreferredSize().width() +
+                                        2 * kGroupChipPadding,
+                                    kGroupChipMaxWidth);
+    return chip + 2 * kGroupHeaderMargin;
+  }
+
+  bool HandleAccessibleAction(const ui::AXActionData& action_data) override {
+    if (action_data.action == ax::mojom::Action::kDoDefault) {
+      strip_->ToggleGroupView(this);
+      return true;
+    }
+    if (action_data.action == ax::mojom::Action::kShowContextMenu) {
+      strip_->ShowGroupEditorForView(this);
+      return true;
+    }
+    return views::View::HandleAccessibleAction(action_data);
+  }
+
+  // views::View:
+  void Layout(PassKey) override {
+    title_->SetVisible(!ShowsDot());
+    gfx::Rect title_bounds = ChipBounds();
+    title_bounds.Inset(gfx::Insets::VH(0, kGroupChipPadding));
+    title_->SetBoundsRect(title_bounds);
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(GetColorProvider()->GetColor(data_.color));
+    const gfx::Rect chip = ChipBounds();
+    if (ShowsDot()) {
+      canvas->DrawCircle(gfx::PointF(chip.CenterPoint()), kGroupDotSize / 2.0f,
+                         flags);
+    } else {
+      canvas->DrawRoundRect(gfx::RectF(chip), kGroupChipRadius, flags);
+    }
+  }
+
+  void OnThemeChanged() override {
+    views::View::OnThemeChanged();
+    UpdateColors();
+  }
+
+ private:
+  bool ShowsDot() const {
+    return data_.title.empty() ||
+           (strip_->vertical() && width() < kVerticalTabNarrowWidth);
+  }
+
+  gfx::Rect ChipBounds() const {
+    // Horizontal tabs leave room above them, see UnifiedTabView.
+    const int top = strip_->vertical() ? 0 : kTabTopInset;
+    const int y = top + (height() - top - kGroupChipHeight) / 2;
+    if (!strip_->vertical()) {
+      return gfx::Rect(kGroupHeaderMargin, y, width() - 2 * kGroupHeaderMargin,
+                       kGroupChipHeight);
+    }
+    if (ShowsDot() && width() < kVerticalTabNarrowWidth) {
+      return gfx::Rect(0, y, width(), kGroupChipHeight);
+    }
+    const int chip_width =
+        data_.title.empty() ? kGroupEmptyChipWidth
+                            : std::min(title_->GetPreferredSize().width() +
+                                           2 * kGroupChipPadding,
+                                       width() - 2 * kVerticalGroupChipInset);
+    return gfx::Rect(kVerticalGroupChipInset, y, chip_width, kGroupChipHeight);
+  }
+
+  void UpdateColors() {
+    if (GetColorProvider()) {
+      title_->SetEnabledColor(color_utils::GetColorWithMaxContrast(
+          GetColorProvider()->GetColor(data_.color)));
+    }
+  }
+
+  const raw_ptr<UnifiedTabStrip> strip_;
+  UnifiedGroupData data_;
+  raw_ptr<views::Label> title_ = nullptr;
+};
