+int UnifiedTabStrip::GapGroup(const std::vector<Item>& rest, size_t gap) const {
+  if (gap == 0) {
+    return -1;
+  }
+  const Item& left = rest[gap - 1];
+  if (left.header) {
+    return groups_[left.index].collapsed ? -1 : left.index;
+  }
+  const int group = tabs_[left.index]->data().group;
+  return group >= 0 && gap < rest.size() && !rest[gap].header &&
+                 tabs_[rest[gap].index]->data().group == group
+             ? group
+             : -1;
+}
+
+bool UnifiedTabStrip::IsValidGap(const std::vector<Item>& rest,
+                                 size_t gap) const {
+  const Item& dragged = items_[pressed_item_];
+  const int group = GapGroup(rest, gap);
+  if (dragged.header) {
+    return group < 0;
+  }
+  return group < 0 ||
+         groups_[group].window == tabs_[dragged.index]->data().window;
+}
+
+int UnifiedTabStrip::DropTabIndex(const std::vector<Item>& rest,
+                                  size_t gap) const {
+  const Item& dragged = items_[pressed_item_];
+  const int first = FirstTabOf(dragged);
+  const int count = dragged.header ? GroupTabCount(dragged.index) : 1;
+  const int before = gap < rest.size() ? FirstTabOf(rest[gap])
+                                       : static_cast<int>(tabs_.size());
+  return before - (first < before ? count : 0);
+}
