+// The tabs of a group stay together, where its first tab is, as they are in
+// their window.
+void KeepGroupsTogether(std::vector<TabSlot>& order) {
+  std::vector<TabSlot> together;
+  std::vector<tab_groups::TabGroupId> placed;
+  for (size_t i = 0; i < order.size(); ++i) {
+    const std::optional<tab_groups::TabGroupId> group =
+        order[i].tab->GetGroup();
+    if (!group) {
+      together.push_back(order[i]);
+      continue;
+    }
+    if (std::ranges::contains(placed, *group)) {
+      continue;
+    }
+    placed.push_back(*group);
+    for (size_t j = i; j < order.size(); ++j) {
+      if (order[j].tab->GetGroup() == group) {
+        together.push_back(order[j]);
+      }
+    }
+  }
+  order = std::move(together);
+}
