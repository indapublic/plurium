+// Pinned tabs come first in the strip, those of all profiles, as they come
+// first in each window.
+void KeepPinnedTabsFirst(std::vector<TabSlot>& order) {
+  std::stable_partition(order.begin(), order.end(), [](const TabSlot& slot) {
+    return slot.tab->IsPinned();
+  });
+  for (TabSlot& slot : order) {
+    slot.pinned = slot.tab->IsPinned();
+  }
+}
