-  if (from < 0 || from >= count || to < 0 || to >= count || from == to) {
+  if (from < 0 || from >= count || to < 0 || to >= count) {
+    return;
+  }
+  // Pinned tabs stay in front of the others.
+  const int pinned = static_cast<int>(std::ranges::count_if(
+      order, [](const TabSlot& slot) { return slot.tab->IsPinned(); }));
+  to = order[from].tab->IsPinned() ? std::min(to, pinned - 1)
+                                   : std::max(to, pinned);
+  if (from == to) {
     return;
   }
