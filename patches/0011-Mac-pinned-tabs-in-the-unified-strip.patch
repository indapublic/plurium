   });
 
+  // Like Chromium in the window, a tab that got pinned goes after the pinned
+  // tabs of the strip, one that got unpinned before the other tabs.
+  std::vector<tabs::TabInterface*> repinned;
+  for (const TabSlot& slot : order) {
+    if (slot.tab->IsPinned() != slot.pinned) {
+      repinned.push_back(slot.tab);
+    }
+  }
+  for (tabs::TabInterface* tab : repinned) {
+    const size_t from = IndexOfTab(tab);
+    TabSlot slot = order[from];
+    order.erase(order.begin() + from);
+    slot.pinned = tab->IsPinned();
+    order.insert(std::ranges::find_if(
+                     order, [](const TabSlot& other) { return !other.pinned; }),
+                 slot);
+  }
