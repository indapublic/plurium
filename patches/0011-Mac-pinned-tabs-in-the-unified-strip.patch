+gfx::Rect UnifiedTabStrip::SlotBounds(int slot) const {
+  const int unpinned = slot - pinned_count_;
+  if (!vertical_) {
+    if (unpinned < 0) {
+      return gfx::Rect(slot * kPinnedTabWidth, 0, kPinnedTabWidth, height());
+    }
+    const int tab_width = TabWidth();
+    return gfx::Rect(pinned_count_ * kPinnedTabWidth + unpinned * tab_width, 0,
+                     tab_width, height());
+  }
+  if (unpinned < 0) {
+    const int columns = PinnedColumns();
+    const int tile_width =
+        (width() - (columns - 1) * kVerticalPinnedTileSpacing) / columns;
+    return gfx::Rect(
+        (slot % columns) * (tile_width + kVerticalPinnedTileSpacing),
+        (slot / columns) * (kVerticalTabHeight + kVerticalPinnedTileSpacing),
+        tile_width, kVerticalTabHeight);
+  }
+  return gfx::Rect(
+      0, RowsTop() + unpinned * (kVerticalTabHeight + kVerticalTabSpacing),
+      width(), kVerticalTabHeight);
+}
+
+int UnifiedTabStrip::PinnedColumns() const {
+  return std::max(
+      1, (width() + kVerticalPinnedTileSpacing) /
+             (kVerticalPinnedTileMinWidth + kVerticalPinnedTileSpacing));
+}
+
+int UnifiedTabStrip::RowsTop() const {
+  if (!pinned_count_) {
+    return 0;
+  }
+  const int rows = (pinned_count_ + PinnedColumns() - 1) / PinnedColumns();
+  return rows * kVerticalTabHeight + (rows - 1) * kVerticalPinnedTileSpacing +
+         kVerticalPinnedSpacing;
+}
+
+int UnifiedTabStrip::ContentHeight() const {
+  const int count = static_cast<int>(tabs_.size());
+  return count > pinned_count_
+             ? SlotBounds(count - 1).bottom() + kVerticalTabSpacing
+             : RowsTop();
 }
 
