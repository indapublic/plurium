+  // The marks are clipped to the shape of the active tab's background, so
+  // they follow its rounded top corners.
+  void PaintProfileMark(gfx::Canvas* canvas) {
+    gfx::ScopedCanvas scoped_canvas(canvas);
+    canvas->ClipPath(SkPath::RRect(SkRRect::MakeRectXY(
+                         SkRect::MakeLTRB(0, kTabTopInset, width(),
+                                          height() + kCornerRadius),
+                         kCornerRadius, kCornerRadius)),
+                     /*do_anti_alias=*/true);
+    cc::PaintFlags mark;
+    mark.setAntiAlias(true);
+    mark.setColor(data_.profile_color);
+    const float half = kMarkLineWidth / 2;
+    switch (strip_->mark_style()) {
+      case ProfileMarkStyle::kTriangle: {
+        SkPathBuilder triangle;
+        triangle.moveTo(0, kTabTopInset);
+        triangle.lineTo(kMarkTriangleSize, kTabTopInset);
+        triangle.lineTo(0, kTabTopInset + kMarkTriangleSize);
+        triangle.close();
+        canvas->DrawPath(triangle.detach(), mark);
+        break;
+      }
+      case ProfileMarkStyle::kTopLine:
+        canvas->DrawRoundRect(
+            gfx::RectF(kMarkLineInset, kTabTopInset,
+                       width() - 2 * kMarkLineInset, kMarkLineWidth),
+            half, mark);
+        break;
+      case ProfileMarkStyle::kBottomLine:
+        canvas->DrawRoundRect(
+            gfx::RectF(kTabPadding,
+                       height() - kMarkBottomInset - kMarkLineWidth,
+                       width() - 2 * kTabPadding, kMarkLineWidth),
+            half, mark);
+        break;
+      case ProfileMarkStyle::kSideBar: {
+        const float center_y = kTabTopInset + (height() - kTabTopInset) / 2.0f;
+        canvas->DrawRoundRect(
+            gfx::RectF(kMarkSideInset, center_y - kMarkSideHeight / 2,
+                       kMarkLineWidth, kMarkSideHeight),
+            half, mark);
+        break;
+      }
+      case ProfileMarkStyle::kCorner: {
+        mark.setStyle(cc::PaintFlags::kStroke_Style);
+        mark.setStrokeWidth(kMarkLineWidth);
+        mark.setStrokeCap(cc::PaintFlags::kRound_Cap);
+        const float top = kTabTopInset + half;
+        const float radius = kCornerRadius - half;
+        SkPathBuilder corner;
+        corner.moveTo(half, top + kMarkCornerLength);
+        corner.lineTo(half, top + radius);
+        corner.arcTo(SkRect::MakeLTRB(half, top, half + 2 * radius,
+                                      top + 2 * radius),
+                     180, 90, false);
+        corner.lineTo(half + kMarkCornerLength, top);
+        canvas->DrawPath(corner.detach(), mark);
+        break;
+      }
+      case ProfileMarkStyle::kNone:
+        break;
+    }
+  }
