+void UnifiedTabStrip::SetMarkStyle(ProfileMarkStyle style) {
+  if (style == mark_style_) {
+    return;
+  }
+  mark_style_ = style;
+  DeprecatedLayoutImmediately();
+  for (UnifiedTabView* tab : tabs_) {
+    tab->SchedulePaint();
+  }
+}
