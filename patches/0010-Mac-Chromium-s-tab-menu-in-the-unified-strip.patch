+  static bool IsOwnCommand(int command_id) {
+    return command_id >= kFirstMenuCommand && command_id <= kLastMenuCommand;
+  }
+
+  // Commands of Chromium's tab menu itself; its submenus number theirs from
+  // 1001 on and handle them.
+  bool IsTabMenuCommand(int command_id) const {
+    return tab_menu_ && command_id >= 0 && command_id <= 1000;
+  }
+
+  extensions::ContextMenuMatcher* ExtensionItems(int command_id) const {
+    if (!tab_menu_ ||
+        !extensions::ContextMenuMatcher::IsExtensionsCustomCommandId(
+            command_id)) {
+      return nullptr;
+    }
+    return tab_menu_->extension_items();
+  }
+
+  // Where the tab menu's tab is in its window, or -1 if it was closed.
+  int MenuTabIndex() const {
+    if (!tab_menu_ ||
+        !std::ranges::contains(AllWindows(), menu_tab_.window.get())) {
+      return -1;
+    }
+    return menu_tab_.window->model()->GetIndexOfTab(menu_tab_.tab);
+  }
+
+  // "Close Other Tabs" and "Close Tabs to the Right" of the unified strip:
+  // the other tabs or the tabs after the menu's tab, of all profiles, except
+  // pinned ones (as in Chromium).
+  std::vector<tabs::TabHandle> TabsToClose(
+      TabStripModel::ContextMenuCommand command) const {
+    std::vector<tabs::TabHandle> tabs;
+    const std::vector<TabSlot>& order = TabOrder();
+    const size_t menu_tab = IndexOfTab(menu_tab_.tab);
+    if (menu_tab == order.size()) {
+      return tabs;
+    }
+    const size_t first =
+        command == TabStripModel::CommandCloseTabsToRight ? menu_tab + 1 : 0;
+    for (size_t i = first; i < order.size(); ++i) {
+      // The order catches up with closed tabs and windows a moment later.
+      if (i != menu_tab &&
+          std::ranges::contains(AllWindows(), order[i].window.get()) &&
+          order[i].window->model()->GetIndexOfTab(order[i].tab) >= 0 &&
+          !order[i].tab->IsPinned()) {
+        tabs.push_back(order[i].tab->GetHandle());
+      }
+    }
+    return tabs;
+  }
+
+  // Chromium runs the commands in the tab's window; the ones that depend on
+  // the order of tabs follow the unified strip.
+  void ExecuteTabMenuCommand(TabStripModel::ContextMenuCommand command) {
+    const int index = MenuTabIndex();
+    if (index < 0) {
+      return;
+    }
+    ProfileTabsWindow* window = menu_tab_.window;
+    switch (command) {
+      case TabStripModel::CommandCloseOtherTabs:
+      case TabStripModel::CommandCloseTabsToRight: {
+        const std::vector<tabs::TabHandle> tabs = TabsToClose(command);
+        for (auto it = tabs.rbegin(); it != tabs.rend(); ++it) {
+          for (ProfileTabsWindow* other : AllWindows()) {
+            const int other_index =
+                it->Get() ? other->model()->GetIndexOfTab(it->Get()) : -1;
+            if (other_index >= 0) {
+              other->model()->CloseWebContentsAt(
+                  other_index, TabCloseTypes::CLOSE_USER_GESTURE);
+              break;
+            }
+          }
+        }
+        return;
+      }
+      case TabStripModel::CommandNewTabToRight:
+      case TabStripModel::CommandDuplicate:
+        // Right after the tab, also when it is the last one of its window.
+        PendingTabPlacement() = PendingPlacement{
+            .window = window,
+            .index = IndexOfTab(menu_tab_.tab) + 1,
+            .expires = base::TimeTicks::Now() + kMenuPlacementTimeout};
+        window->model()->ExecuteContextMenuCommand(index, command);
+        if (window != this) {
+          SelectTab(window->ns_window());
+        }
+        return;
+      default:
+        window->model()->ExecuteContextMenuCommand(index, command);
+    }
+  }
+
+  // Drops the separators left at the ends or next to each other.
+  static void RemoveExtraSeparators(ui::SimpleMenuModel& menu) {
+    for (size_t i = menu.GetItemCount(); i > 0; --i) {
+      const size_t at = i - 1;
+      if (menu.GetTypeAt(at) == ui::MenuModel::TYPE_SEPARATOR &&
+          (at == 0 || at + 1 == menu.GetItemCount() ||
+           menu.GetTypeAt(at + 1) == ui::MenuModel::TYPE_SEPARATOR)) {
+        menu.RemoveItemAt(at);
+      }
+    }
+  }
+
   void RunMenu(const gfx::Point& screen_point) {
     menu_runner_ = std::make_unique<views::MenuRunner>(
         menu_model_.get(), views::MenuRunner::CONTEXT_MENU);
@@ -1359,6 +1561,8 @@ class ProfileTabsWindow : public views::WidgetObserver,
