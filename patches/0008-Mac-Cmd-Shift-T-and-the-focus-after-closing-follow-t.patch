+  // Records closed tabs for Cmd+Shift+T and, when the active tab was closed,
+  // activates its neighbor in the unified strip (Chrome picks one in the
+  // window, and AppKit some other window when the last tab closes). The
+  // global order still has the removed tabs here.
+  void OnTabsClosed(const TabStripModelChange::Remove& remove,
+                    const TabStripSelectionChange& selection) {
+    std::vector<const tabs::TabInterface*> closed;
+    for (const TabStripModelChange::RemovedTab& removed : remove.contents) {
+      if (removed.remove_reason == TabRemovedReason::kDeleted) {
+        RecordClosedTab(profile(), IndexOfTab(removed.tab));
+        closed.push_back(removed.tab);
+      }
+    }
+    if (!selection.active_tab_changed() || !selection.old_tab ||
+        !std::ranges::contains(closed, selection.old_tab.get()) ||
+        !GetNSWindow().isKeyWindow) {
+      return;
+    }
+    const std::vector<TabSlot>& order = TabOrder();
+    const size_t index = IndexOfTab(selection.old_tab);
+    const auto open = [&](size_t i) {
+      return !std::ranges::contains(closed, order[i].tab.get());
+    };
+    for (size_t i = index + 1; i < order.size(); ++i) {
+      if (open(i)) {
+        FocusTabSoon(order[i].window, order[i].tab);
+        return;
+      }
+    }
+    for (size_t i = std::min(index, order.size()); i > 0; --i) {
+      if (open(i - 1)) {
+        FocusTabSoon(order[i - 1].window, order[i - 1].tab);
+        return;
+      }
+    }
+  }
