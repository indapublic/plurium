+// Restores the most recent entry of a profile that has no window open, after
+// loading its closed tabs if needed. Owns itself.
+class RestoreWhenLoaded : public sessions::TabRestoreServiceObserver {
+ public:
+  static void Start(sessions::TabRestoreService* service) {
+    if (service->IsLoaded()) {
+      service->RestoreMostRecentEntry(nullptr);
+      return;
+    }
+    new RestoreWhenLoaded(service);
+  }
+
+  // sessions::TabRestoreServiceObserver:
+  void TabRestoreServiceLoaded(sessions::TabRestoreService* service) override {
+    service->RemoveObserver(this);
+    service->RestoreMostRecentEntry(nullptr);
+    delete this;
+  }
+  void TabRestoreServiceDestroyed(
+      sessions::TabRestoreService* service) override {
+    service->RemoveObserver(this);
+    delete this;
+  }
+
+ private:
+  explicit RestoreWhenLoaded(sessions::TabRestoreService* service) {
+    service->AddObserver(this);
+    service->LoadTabsFromLastSession();
+  }
+};
+
+// Cmd+Shift+T: the newest closed entry of all profiles, from Chrome's own
+// entries for profiles with a window and the recorded closes for the others,
+// reopens in its profile (a new window of it if needed) at its old place.
+bool RestoreClosedTab() {
+  struct Candidate {
+    ProfileKey profile;
+    base::Time when;
+    raw_ptr<ProfileTabsWindow> window;
+  };
+  std::optional<Candidate> best;
+  const auto consider = [&](const Candidate& candidate) {
+    if (!best || candidate.when > best->when) {
+      best = candidate;
+    }
+  };
+  const auto window_of = [](const ProfileKey& key) -> ProfileTabsWindow* {
+    for (ProfileTabsWindow* window : AllWindows()) {
+      if (window->attached() && KeyOf(window->profile()) == key) {
+        return window;
+      }
+    }
+    return nullptr;
+  };
+  for (ProfileTabsWindow* window : AllWindows()) {
+    sessions::TabRestoreService* service =
+        TabRestoreServiceFactory::GetForProfileIfExisting(window->profile());
+    if (window->attached() && service && service->IsLoaded() &&
+        !service->entries().empty()) {
+      consider({KeyOf(window->profile()), service->entries().front()->timestamp,
+                window});
+    }
+  }
+  for (const ClosedTabs& closed : AllClosedTabs()) {
+    // An incognito profile without windows is gone, with its closed tabs.
+    if (!closed.tabs.empty() && !closed.profile.off_the_record &&
+        !window_of(closed.profile)) {
+      consider({closed.profile, closed.tabs.back().when, nullptr});
+    }
+  }
+  if (!best) {
+    return false;
+  }
+  VLOG(1) << "profile tabs: reopening a closed tab of "
+          << best->profile.path.BaseName() << (best->window ? "" : " (no window)");
+  if (ClosedTabs* closed = FindClosedTabs(best->profile);
+      closed && !closed->tabs.empty()) {
+    PendingTabPlacement() =
+        PendingPlacement{nullptr, closed->tabs.back().index,
+                         best->profile.path, best->profile.off_the_record,
+                         base::TimeTicks::Now() + kRestorePlacementTimeout};
+    closed->tabs.pop_back();
+  }
+  if (best->window) {
+    chrome::RestoreTab(best->window->browser());
+    SelectTab(best->window->ns_window());
+    return true;
+  }
+  g_browser_process->profile_manager()->LoadProfileByPath(
+      best->profile.path, /*incognito=*/false,
+      base::BindOnce([](Profile* profile) {
+        if (!profile) {
+          return;
+        }
+        if (sessions::TabRestoreService* service =
+                TabRestoreServiceFactory::GetForProfile(profile)) {
+          RestoreWhenLoaded::Start(service);
+        }
+      }));
+  return true;
+}
+
+void FocusTabSoon(ProfileTabsWindow* window, tabs::TabInterface* tab) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](ProfileTabsWindow* window, tabs::TabInterface* tab) {
+            if (!std::ranges::contains(AllWindows(), window)) {
+              return;
+            }
+            const int index = window->model()->GetIndexOfTab(tab);
+            if (index < 0) {
+              return;
+            }
+            window->model()->ActivateTabAt(
+                index, TabStripUserGestureDetails(
+                           TabStripUserGestureDetails::GestureType::kOther));
+            SelectTab(window->ns_window());
+          },
+          base::Unretained(window), base::Unretained(tab)));
+}
