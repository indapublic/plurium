+// Closes of tabs by the user, per profile, newest last. Chrome keeps closed
+// tabs per profile; with these Cmd+Shift+T reopens the most recently closed
+// tab of any profile, in its profile and at its place in the unified strip.
+struct ClosedTab {
+  size_t index;  // In the global order.
+  base::Time when;
+};
+struct ProfileKey {
+  base::FilePath path;  // Of the original profile.
+  bool off_the_record;
+  bool operator==(const ProfileKey&) const = default;
+};
+struct ClosedTabs {
+  ProfileKey profile;
+  std::vector<ClosedTab> tabs;
+};
+constexpr size_t kMaxClosedTabsPerProfile = 25;
+constexpr base::TimeDelta kRestorePlacementTimeout = base::Seconds(15);
+
+ProfileKey KeyOf(Profile* profile) {
+  return {profile->GetOriginalProfile()->GetPath(), profile->IsOffTheRecord()};
+}
+
+std::vector<ClosedTabs>& AllClosedTabs() {
+  static base::NoDestructor<std::vector<ClosedTabs>> closed;
+  return *closed;
+}
+
+ClosedTabs* FindClosedTabs(const ProfileKey& key) {
+  for (ClosedTabs& closed : AllClosedTabs()) {
+    if (closed.profile == key) {
+      return &closed;
+    }
+  }
+  return nullptr;
+}
+
+void RecordClosedTab(Profile* profile, size_t index) {
+  const ProfileKey key = KeyOf(profile);
+  ClosedTabs* closed = FindClosedTabs(key);
+  if (!closed) {
+    closed = &AllClosedTabs().emplace_back(ClosedTabs{key, {}});
+  }
+  closed->tabs.push_back({index, base::Time::Now()});
+  if (closed->tabs.size() > kMaxClosedTabsPerProfile) {
+    closed->tabs.erase(closed->tabs.begin());
+  }
+}
+
+// Set while "Move to profile" closes the source tab: that is no close to
+// undo, and the moved tab keeps the focus.
+bool g_moving_tab = false;
+
+bool RestoreClosedTab();
+void FocusTabSoon(ProfileTabsWindow* window, tabs::TabInterface* tab);
 void UpdateAllTitles();
 void RefreshAllLayouts();
 void PostRefreshAllLayouts();
